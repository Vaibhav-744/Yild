{%- style -%}
  #yild-blog-{{ section.id }} {
    background: {{ section.settings.bg_color }};
  }
  #yild-blog-{{ section.id }} .blog-hero {
    padding: clamp(60px, 8vw, 110px) clamp(20px, 4vw, 54px) clamp(36px, 5vw, 60px);
    background: {{ section.settings.hero_bg_color }};
  }
  #yild-blog-{{ section.id }} .blog-hero-content {
    max-width: 1440px;
    margin: 0 auto;
  }
  #yild-blog-{{ section.id }} .blog-hero-subtitle {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.248rem !important; /* Scaled 0.78rem * 1.6 */
    font-weight: 600 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }} !important;
    margin: 0 0 14px 0 !important;
    line-height: 1.2 !important;
  }
  #yild-blog-{{ section.id }} .blog-hero-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.84rem, 5.4vw, 6.72rem) !important; /* Scaled clamp(2.4rem, 5.4vw, 4.2rem) */
    line-height: 1.04 !important;
    color: {{ section.settings.title_color }} !important;
    max-width: 18ch !important;
    margin: 0 !important;
    letter-spacing: normal;
  }

  /* Featured Post Layout */
  #yild-blog-{{ section.id }} .featured-post-section {
    padding: 0 clamp(20px, 4vw, 54px) clamp(40px, 5vw, 64px);
    background: {{ section.settings.bg_color }};
  }
  #yild-blog-{{ section.id }} .feature-card {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    background: {{ section.settings.featured_bg }};
    color: {{ section.settings.featured_txt }};
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(31, 61, 43, 0.16);
    text-decoration: none !important;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-blog-{{ section.id }} .feature-card.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-blog-{{ section.id }} .feature-img-wrap {
    position: relative;
    min-height: clamp(240px, 30vw, 400px);
    background: #f7f5ed;
  }
  #yild-blog-{{ section.id }} .feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #yild-blog-{{ section.id }} .feature-content {
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  #yild-blog-{{ section.id }} .feature-tag-eyebrow {
    font-family: var(--font-family-1) !important;
    font-size: 1.152rem !important; /* Scaled 0.72rem * 1.6 */
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase;
    color: {{ section.settings.featured_accent }} !important;
    line-height: 1.2 !important;
  }
  #yild-blog-{{ section.id }} .feature-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(2.56rem, 3vw, 3.84rem) !important; /* Scaled clamp(1.6rem, 3vw, 2.4rem) */
    line-height: 1.12 !important;
    margin: 0 !important;
    color: {{ section.settings.featured_txt }} !important;
    letter-spacing:normal;
  }
  #yild-blog-{{ section.id }} .feature-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.6rem !important; /* Scaled 1rem * 1.6 */
    line-height: 1.6 !important;
    color: {{ section.settings.featured_desc_color }} !important;
    margin: 0 !important;
    letter-spacing: normal;
  }
  #yild-blog-{{ section.id }} .feature-link-lbl {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.44rem !important; /* Scaled 0.9rem * 1.6 */
    color: {{ section.settings.featured_accent }} !important;
  }

  /* Grid Posts Layout */
  #yild-blog-{{ section.id }} .posts-grid-section {
    padding: 0 clamp(20px, 4vw, 54px) clamp(58px, 7vw, 96px);
    background: {{ section.settings.bg_color }};
  }
  #yild-blog-{{ section.id }} .blog-posts-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  #yild-blog-{{ section.id }} .post-card-item {
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(31, 61, 43, 0.05);
    text-decoration: none !important;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-blog-{{ section.id }} .post-card-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-blog-{{ section.id }} .post-card-item:hover {
    transform: translateY(-2px);
  }
  #yild-blog-{{ section.id }} .post-img-wrap {
    aspect-ratio: 1.5;
    overflow: hidden;
    background: #f7f5ed;
  }
  #yild-blog-{{ section.id }} .post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-blog-{{ section.id }} .post-card-item:hover .post-img {
    transform: scale(1.02);
  }
  #yild-blog-{{ section.id }} .post-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  #yild-blog-{{ section.id }} .post-tag-eyebrow {
    font-family: var(--font-family-1) !important;
    font-size: 1.12rem !important; /* Scaled 0.7rem * 1.6 */
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase;
    color: {{ section.settings.card_accent }} !important;
    margin: 0 !important;
    line-height: 1.2 !important;
  }
  #yild-blog-{{ section.id }} .post-title {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.792rem !important; /* Scaled 1.12rem * 1.6 */
    line-height: 1.25 !important;
    color: {{ section.settings.title_color }} !important;
    margin: 0 !important;
  }
  #yild-blog-{{ section.id }} .post-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.472rem !important; /* Scaled 0.92rem * 1.6 */
    color: {{ section.settings.desc_color }} !important;
    line-height: 1.55 !important;
    margin: 0 !important;
    letter-spacing: normal;
  }
  #yild-blog-{{ section.id }} .post-read-time {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--font-family-1) !important;
    font-size: 1.36rem !important; /* Scaled 0.85rem * 1.6 */
    font-weight: 600 !important;
    color: {{ section.settings.card_accent }} !important;
  }

  @media (max-width: 980px) {
    #yild-blog-{{ section.id }} .feature-card {
      grid-template-columns: 1fr !important;
    }
    #yild-blog-{{ section.id }} .blog-posts-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 620px) {
    #yild-blog-{{ section.id }} .blog-posts-grid {
      grid-template-columns: 1fr !important;
    }
  }
{%- endstyle -%}

<section id="yild-blog-{{ section.id }}" class="yild-blog-wrapper-section">
  <div class="blog-hero">
    <div class="blog-hero-content">
      {%- if section.settings.hero_subtitle != blank -%}
        <span class="blog-hero-subtitle">{{ section.settings.hero_subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.hero_title != blank -%}
        <h1 class="blog-hero-title">{{ section.settings.hero_title }}</h1>
      {%- endif -%}
    </div>
  </div>

  {%- paginate blog.articles by section.settings.posts_per_page -%}
    
    {%- comment -%} Determine Featured Post {%- endcomment -%}
    {%- assign featured_article = nil -%}
    {%- for article in blog.articles -%}
      {%- for tag in article.tags -%}
        {%- assign downcase_tag = tag | downcase -%}
        {%- if downcase_tag == 'featured' -%}
          {%- assign featured_article = article -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if featured_article != nil -%}{%- break -%}{%- endif -%}
    {%- endfor -%}

    {%- comment -%} Page 1 Featured Article Banner Display {%- endcomment -%}
    {%- if paginate.current_page == 1 and featured_article != nil -%}
      <div class="featured-post-section">
        <a class="feature-card" href="{{ featured_article.url }}">
          <div class="feature-img-wrap">
            {%- if featured_article.image != blank -%}
              {{ featured_article.image | image_url: width: 1000 | image_tag: class: 'feature-img', loading: 'eager', alt: featured_article.title | escape }}
            {%- else -%}
              <img src="{{ 'veg-spread.png' | asset_url }}" alt="{{ featured_article.title }}" class="feature-img" loading="eager" onerror="this.onerror=null;this.src='{{ 'rainbow-box.jpg' | asset_url }}';" />
            {%- endif -%}
          </div>
          <div class="feature-content">
            <span class="feature-tag-eyebrow">
              Featured 
              {%- for tag in featured_article.tags -%}
                {%- assign downcase_tag = tag | downcase -%}
                {%- unless downcase_tag == 'featured' -%}
                  · {{ tag }}
                  {%- break -%}
                {%- endunless -%}
              {%- endfor -%}
            </span>
            <h2 class="feature-title">{{ featured_article.title }}</h2>
            {%- if featured_article.excerpt != blank -%}
              <p class="feature-desc">{{ featured_article.excerpt | strip_html | truncatewords: 30 }}</p>
            {%- else -%}
              <p class="feature-desc">{{ featured_article.content | strip_html | truncatewords: 30 }}</p>
            {%- endif -%}
            <span class="feature-link-lbl">Read the guide →</span>
          </div>
        </a>
      </div>
    {%- endif -%}

    <div class="posts-grid-section">
      <div class="blog-posts-grid">
        {%- for article in blog.articles -%}
          {%- if featured_article != nil and article.id == featured_article.id and paginate.current_page == 1 -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign category_tag = "" -%}
          {%- for tag in article.tags -%}
            {%- assign downcase_tag = tag | downcase -%}
            {%- unless downcase_tag == 'featured' -%}
              {%- assign category_tag = tag -%}
              {%- break -%}
            {%- endunless -%}
          {%- endfor -%}
          {%- if category_tag == "" -%}
            {%- assign category_tag = blog.title -%}
          {%- endif -%}

          {%- assign words = article.content | strip_html | number_of_words -%}
          {%- assign read_time = words | divided_by: 200 | at_least: 1 -%}

          <a class="post-card-item" href="{{ article.url }}">
            <div class="post-img-wrap">
              {%- if article.image != blank -%}
                {{ article.image | image_url: width: 600 | image_tag: class: 'post-img', loading: 'lazy', alt: article.title | escape }}
              {%- else -%}
                <img src="{{ 'dairy-hamper.png' | asset_url }}" alt="{{ article.title }}" class="post-img" loading="lazy" onerror="this.onerror=null;this.src='{{ 'yild-box.jpg' | asset_url }}';" />
              {%- endif -%}
            </div>
            <div class="post-content">
              <span class="post-tag-eyebrow">{{ category_tag }}</span>
              <h3 class="post-title">{{ article.title }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="post-desc">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
              {%- else -%}
                <p class="post-desc">{{ article.content | strip_html | truncatewords: 20 }}</p>
              {%- endif -%}
              <span class="post-read-time">{{ read_time }} min read</span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    </div>

  {%- endpaginate -%}
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("yild-blog-{{ section.id }}");
      if (!section) return;

      const items = section.querySelectorAll('.feature-card, .post-card-item');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      items.forEach(item => {
        observer.observe(item);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Yild Blog",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#f7f5ed"
    },
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Hero Background Color",
      "default": "#f7f5ed"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#4e7355"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#5d6b60"
    },
    {
      "type": "text",
