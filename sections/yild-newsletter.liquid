{%- style -%}
  #yild-newsletter-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 54px) {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #yild-newsletter-{{ section.id }} .offer-card {
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 30px;
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_txt }};
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    box-shadow: 0 20px 50px rgba(31, 61, 43, 0.12);
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-newsletter-{{ section.id }} .offer-card.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-newsletter-{{ section.id }} .offer-content {
    padding: clamp(40px, 6vw, 64px) clamp(28px, 5vw, 68px);
  }
  #yild-newsletter-{{ section.id }} .offer-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(2.88rem, 3.4vw, 4.16rem) !important; /* Scaled clamp(1.8rem, 3.4vw, 2.6rem) */
    line-height: 1.08 !important;
    margin: 0 0 12px 0 !important;
    color: {{ section.settings.card_txt }} !important;
    letter-spacing: normal;
  }
  #yild-newsletter-{{ section.id }} .offer-desc {
    font-family: var(--font-family-1) !important;
    color: {{ section.settings.desc_color }} !important;
    font-size: 1.632rem !important; /* Scaled 1.02rem * 1.6 */
    line-height: 1.55 !important;
    margin: 0 0 24px 0 !important;
    letter-spacing: normal;
  }
  #yild-newsletter-{{ section.id }} .offer-img-box {
    position: relative;
    min-height: 280px;
    background: #f7f5ed;
  }
  #yild-newsletter-{{ section.id }} .offer-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #yild-newsletter-{{ section.id }} .offer-gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, {{ section.settings.overlay_color_1 }} 0%, rgba(31, 61, 43, 0) 45%);
    display:block;
    opacity:1;
  }

  @media (max-width: 980px) {
    #yild-newsletter-{{ section.id }} .offer-card {
      grid-template-columns: 1fr !important;
    }
    #yild-newsletter-{{ section.id }} .offer-gradient-overlay {
      background: linear-gradient(0deg, {{ section.settings.overlay_color_1 }} 0%, rgba(31, 61, 43, 0) 45%) !important;
    }
  }
{%- endstyle -%}

<section id="yild-newsletter-{{ section.id }}" class="yild-newsletter-wrapper-section">
  <div class="offer-card">
    <div class="offer-content">
      {%- if section.settings.title != blank -%}
        <h2 class="offer-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="offer-desc">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        
        {%- if form.posted_successfully? -%}
          <p class="newsletter-form-note" style="color: #cfe0cf; font-weight: 500; font-size: 1.6rem; padding-bottom: 12px; margin: 0;">
            {{ section.settings.success_message }}
          </p>
        {%- elsif form.errors -%}
          <p class="newsletter-form-note" style="color: #ffb3b3; font-weight: 500; font-size: 1.6rem; padding-bottom: 12px; margin: 0;">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div style="display: flex; gap: 12px; flex-wrap: wrap; max-width: 520px; width: 100%;">
          <input 
            type="email" 
            name="contact[email]" 
            value="{{ form.email }}"
            aria-required="true"
            required 
            placeholder="you@email.com" 
            style="flex: 1; min-width: 220px; padding: 15px 20px; border-radius: 100px; border: 1.5px solid rgba(241,239,227,.28); background: rgba(241,239,227,.08); color: #f1efe3; font-family: inherit; font-size: 1.6rem;" 
          />
          <button 
            type="submit" 
            style="font-family: inherit; font-size: 1.6rem; font-weight: 600; padding: 15px 30px; border-radius: 100px; background: #f1efe3; color: #1f3d2b; border: none; cursor: pointer; transition: opacity 0.2s;"
          >
            Sign up →
          </button>
        </div>
      {%- endform -%}
    </div>
    <div class="offer-img-box">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'offer-img', loading: 'lazy', alt: section.settings.title | escape }}
      {%- else -%}
        <img src="{{ 'dairy-hamper.png' | asset_url }}" alt="Yild newsletter hamper" class="offer-img" loading="lazy" onerror="this.onerror=null;this.src='{{ 'yild-box.jpg' | asset_url }}';" />
      {%- endif -%}
      <div class="offer-gradient-overlay"></div>
    </div>
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("yild-newsletter-{{ section.id }}");
      if (!section) return;

      const card = section.querySelector('.offer-card');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      if (card) observer.observe(card);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Yild Newsletter Box",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ed"
    },
    {
      "type": "color_background",
      "id": "card_bg",
      "label": "Card Background",
      "default": "linear-gradient(160deg, #1f3d2b, #16301f)"
    },
    {
      "type": "color",
      "id": "card_txt",
      "label": "Card Text Color",
      "default": "#f1efe3"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Card Description Color",
      "default": "rgba(241, 239, 227, 0.82)"
    },
    {
      "type": "color",
      "id": "overlay_color_1",
      "label": "Overlay Gradient End Color",
      "info": "Should match card background color for seamless image blend",
      "default": "#1f3d2b"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get recipes & harvest news in your inbox"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sign up to our newsletter — plus 40% off your first basket with code YILDFRESH."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Column Image"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "You're in! Fresh reads on the way."
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Yild Newsletter Box"
    }
  ]
}
{% endschema %}
