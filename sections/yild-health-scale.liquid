{%- style -%}
  #yild-scale-{{ section.id }} {
    padding: clamp(58px, 7vw, 100px) clamp(20px, 4vw, 54px);
    background: {{ section.settings.bg_color }};
  }
  #yild-scale-{{ section.id }} .scale-container {
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
  }
  #yild-scale-{{ section.id }} .scale-header {
    margin-bottom: clamp(36px, 4vw, 52px);
  }
  #yild-scale-{{ section.id }} .scale-subtitle {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.216rem !important;
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: {{ section.settings.subtitle_color }} !important;
    margin-bottom: 14px;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-scale-{{ section.id }} .scale-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.2rem, 3.6vw, 4.96rem) !important;
    color: {{ section.settings.title_color }} !important;
    margin: 0 0 16px 0 !important;
    line-height: 1.05 !important;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 80ms;
  }
  #yild-scale-{{ section.id }} .scale-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.76rem !important;
    color: {{ section.settings.desc_color }} !important;
    max-width: 60ch !important;
    margin: 0 auto !important;
    line-height: 1.6 !important;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: 160ms;
  }
  #yild-scale-{{ section.id }} .scale-header.is-revealed .scale-subtitle,
  #yild-scale-{{ section.id }} .scale-header.is-revealed .scale-title,
  #yild-scale-{{ section.id }} .scale-header.is-revealed .scale-desc {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-scale-{{ section.id }} .scale-viewport {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    margin: 0 -4px;
    padding: 4px;
  }
  #yild-scale-{{ section.id }} .scale-grid {
    display: flex;
    gap: 16px;
  }
  #yild-scale-{{ section.id }} .scale-card {
    flex: 0 0 calc((100% - 16px) / 2); /* mobile: 2 per view */
    background: #ffffff;
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: 22px;
    padding: 28px 20px;
    box-shadow: 0 10px 30px rgba(31, 61, 43, 0.04);
    opacity: 0;
    transform: translateY(34px);
    scroll-snap-align: start;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-scale-{{ section.id }} .scale-card.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-scale-{{ section.id }} .scale-circle {
    width: 74px;
    height: 74px;
    margin: 0 auto 16px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--title-font);
    font-weight: 500;
    font-size: 1.92rem;
    border-width: 2px;
    border-style: solid;
  }
  #yild-scale-{{ section.id }} .scale-card-title {
    font-family: var(--font-family-1);
    font-weight: 600;
    font-size: 1.792rem;
    color: {{ section.settings.title_color }};
    margin: 0 0 6px 0;
  }
  #yild-scale-{{ section.id }} .scale-card-desc {
    font-size: 1.472rem;
    color: {{ section.settings.card_desc_color }};
    line-height: 1.5;
    margin: 0;
  }
  #yild-scale-{{ section.id }} .scale-dots {
    display: flex;
    justify-content: center;
    margin-top: 26px;
  }
  #yild-scale-{{ section.id }} .scale-dots button {
    height: 9px;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 100px;
    background: var(--yild-dots-inactive);
    margin: 0 4px;
    width: 9px;
    transition: width .3s cubic-bezier(.16,1,.3,1), background .3s;
  }
  #yild-scale-{{ section.id }} .scale-dots button.active {
    width: 26px;
    background: var(--yild-green-dark);
  }

  @media (min-width: 720px) {
    #yild-scale-{{ section.id }} .scale-card {
      flex: 0 0 calc((100% - 48px) / 4); /* desktop: 4 per view */
    }
  }
{%- endstyle -%}

<section id="yild-scale-{{ section.id }}" class="yild-health-scale-section">
  <div class="scale-container">
    <div class="scale-header">
      {%- if section.settings.subtitle != blank -%}
        <span class="scale-subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="scale-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.desc != blank -%}
        <p class="scale-desc">{{ section.settings.desc }}</p>
      {%- endif -%}
    </div>

    <div class="scale-viewport yild-scroller" id="scaleViewport-{{ section.id }}">
      <div class="scale-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'score_tier' -%}
            <div class="scale-card" {{ block.shopify_attributes }}>
              <div class="scale-circle" style="color: {{ block.settings.accent_color }}; background: {{ block.settings.circle_bg }}; border-color: {{ block.settings.circle_border }};">
                {{ block.settings.score_range }}
              </div>
              <h3 class="scale-card-title">{{ block.settings.tier_name }}</h3>
              <p class="scale-card-desc">{{ block.settings.tier_desc }}</p>
            </div>
          {%- endif -%}
        {%- endfor %}
      </div>
    </div>
    
    <div class="scale-dots" id="scaleDots-{{ section.id }}"></div>
  </div>
</section>

<script>
  (function() {
    let revealObserver = null;
    let sliderInstance = null;

    function init() {
      const section = document.getElementById("yild-scale-{{ section.id }}");
      if (!section) return;

      const header = section.querySelector('.scale-header');
      const cards = section.querySelectorAll('.scale-card');

      // 1. Scroll Reveal setup
      if (revealObserver) revealObserver.disconnect();
      revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (header) header.classList.add('is-revealed');
            cards.forEach((card, index) => {
              setTimeout(() => {
                card.classList.add('is-revealed');
              }, index * 90);
            });
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      revealObserver.observe(section);

      // 2. Slider Dot Navigation setup
      const viewport = document.getElementById("scaleViewport-{{ section.id }}");
      const dotsContainer = document.getElementById("scaleDots-{{ section.id }}");
      if (viewport && dotsContainer) {
        const getPerView = () => {
          const firstCard = cards[0];
          if (!firstCard) return 1;
          const cardWidth = firstCard.getBoundingClientRect().width;
          const viewportWidth = viewport.getBoundingClientRect().width;
          return Math.max(1, Math.round(viewportWidth / cardWidth));
        };

        const renderDots = () => {
          const pv = getPerView();
          const pages = Math.ceil(cards.length / pv);
          
          if (pages <= 1) {
            dotsContainer.style.display = 'none';
            dotsContainer.innerHTML = '';
            return;
          }
          
          dotsContainer.style.display = 'flex';
          dotsContainer.innerHTML = '';
          
          let activeIndex;
          const scrollLeft = viewport.scrollLeft;
          const maxScroll = viewport.scrollWidth - viewport.clientWidth;
          if (maxScroll <= 0) {
            activeIndex = 0;
          } else if (scrollLeft >= maxScroll - 15) {
            activeIndex = pages - 1;
          } else {
            activeIndex = Math.round(scrollLeft / viewport.clientWidth);
          }
          if (activeIndex >= pages) activeIndex = pages - 1;

          for (let i = 0; i < pages; i++) {
            const dot = document.createElement('button');
            dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
            if (i === activeIndex) dot.classList.add('active');
            
            dot.addEventListener('click', () => {
              const targetCardIndex = i * pv;
              const targetCard = cards[Math.min(targetCardIndex, cards.length - 1)];
              if (targetCard) {
                viewport.scrollTo({
                  left: targetCard.offsetLeft,
                  behavior: 'smooth'
                });
              }
            });
            dotsContainer.appendChild(dot);
          }
        };

        const updateActiveDot = () => {
          const pv = getPerView();
          const pages = Math.ceil(cards.length / pv);
          
          let activeIndex;
          const scrollLeft = viewport.scrollLeft;
          const maxScroll = viewport.scrollWidth - viewport.clientWidth;
          if (maxScroll <= 0) {
            activeIndex = 0;
          } else if (scrollLeft >= maxScroll - 15) {
            activeIndex = pages - 1;
          } else {
            activeIndex = Math.round(scrollLeft / viewport.clientWidth);
          }
          if (activeIndex >= pages) activeIndex = pages - 1;

          const dots = [...dotsContainer.children];
          if (dots.length !== pages) {
            renderDots();
            return;
          }
          dots.forEach((dot, i) => {
            if (i === activeIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        };

        let scrollTimeout = null;
        viewport.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(updateActiveDot, 60);
        }, { passive: true });

        renderDots();
        window.addEventListener('resize', renderDots);
        
        sliderInstance = {
          destroy: () => {
            window.removeEventListener('resize', renderDots);
          }
        };
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (revealObserver) revealObserver.disconnect();
        if (sliderInstance) sliderInstance.destroy();
      }
    });
  })();
</script>

