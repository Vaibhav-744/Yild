{% comment %} Receive block, type_footer_link_font_size {% endcomment %}
{% liquid
  assign footer_bottom_bg = block.settings.footer_bottom_bg
  assign footer_bottom_bg_gradient = block.settings.footer_bottom_bg_gradient
  assign footer_bottom_color = block.settings.footer_bottom_color
  assign show_payment = block.settings.show_payment
%}
<style>
  {%- if footer_bottom_bg != 'rgba(0,0,0,0)' and footer_bottom_bg != blank -%}
      .footer__content-bottom{background: {% if footer_bottom_bg_gradient != blank %}{{ footer_bottom_bg_gradient }}{% else %}{{ footer_bottom_bg }}{% endif %}}
  {%- endif -%}
  .footer__content-bottom {padding-top: {{ block.settings.pdtop_footer_bottom | append: 'px' }};padding-bottom: {{ block.settings.pdbottom_footer_bottom | append: 'px' }};
      {%- if block.settings.border_top -%}
      border-top: 1px solid {{ block.settings.border_top_color }};
      {%- endif -%}
  }
  {%- if footer_bottom_color != 'rgba(0,0,0,0)' and footer_bottom_color != blank -%}
      .copyright__content{color: {{ footer_bottom_color }}}
  {%- endif -%}
</style>
<div class="footer__content-bottom">
  <div class="container container-{{ container }}">
    <div class="footer-block__bottom" style="display:flex !important;justify-content:space-between !important;align-items:center !important;gap:16px !important;flex-wrap:wrap !important;width:100% !important;flex-direction:row !important;padding:0 !important;">
      {%- if block.settings.show_copyright -%}
        <div class="footer__column-item footer__copyright" style="margin:0 !important;">
          <div class="copyright__content" style="--font-size: {{ type_footer_link_font_size }}px; --text-color: {{ block.settings.copyright_content_color }}">{{ block.settings.copyright_content | default: ' ' }}</div>
        </div>
      {%- endif -%}
      <div class="footer-bottom__link-list" style="display:flex !important;gap:18px !important;flex-wrap:wrap !important;">
        <a href="https://yild-2.myshopify.com/policies/Privacy-Policy" style="text-decoration:none !important;color:rgba(241,239,227,.8) !important;font-size:1.28rem !important;transition:color 0.2s !important;">Privacy Policy</a>
        <a href="https://yild-2.myshopify.com/policies/Refund-Policy" style="text-decoration:none !important;color:rgba(241,239,227,.8) !important;font-size:1.28rem !important;transition:color 0.2s !important;">Returns & Refunds</a>
      </div>
    </div>
  </div>
</div>
