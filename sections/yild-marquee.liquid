    }
  ],
  "presets": [
    {
      "name": "Yild Scrolling Marquee",
      "blocks": [
        {
          "type": "row_1_phrase",
          "settings": { "text": "Fresh from the farm" }
        },
        {
          "type": "row_1_phrase",
          "settings": { "text": "Health-scored 0–100" }
        },
        {
          "type": "row_1_phrase",
          "settings": { "text": "Locally grown" }
        },
        {
          "type": "row_1_phrase",
          "settings": { "text": "Zero middlemen" }
        },
        {
          "type": "row_1_phrase",
          "settings": { "text": "Picked at peak ripeness" }
        },
        {
          "type": "row_2_phrase",
          "settings": { "text": "Direct from Kent farms" }
        },
