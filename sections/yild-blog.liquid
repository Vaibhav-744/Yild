      "id": "posts_per_page",
      "label": "Posts Per Page",
      "min": 3,
      "max": 18,
      "step": 1,
      "default": 7
    },
    {
      "type": "header",
      "content": "Featured Article Options"
    },
    {
      "type": "color",
      "id": "featured_bg",
      "label": "Featured Card Background",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "featured_txt",
      "label": "Featured Card Text Color",
      "default": "#f1efe3"
    },
    {
      "type": "color",
      "id": "featured_desc_color",
