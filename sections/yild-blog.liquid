    },
    {
      "type": "color",
      "id": "featured_accent",
      "label": "Featured Card Accent Color",
      "default": "#9fce0f"
    },
    {
      "type": "header",
      "content": "Post Card Options"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Grid Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Grid Card Border",
      "default": "#e6ebe2"
    },
    {
      "type": "color",
      "id": "card_accent",
      "label": "Grid Card Accent Color",
      "default": "#4e7355"
    }
  ],
  "presets": [
    {
      "name": "Yild Blog Template"
    }
  ]
}
{% endschema %}
