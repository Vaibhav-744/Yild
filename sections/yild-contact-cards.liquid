{%- style -%}
  #contact-cards-{{ section.id }} {
    padding: clamp(20px, 3vw, 40px) clamp(20px, 4vw, 54px);
    background: {{ section.settings.bg_color }};
  }
  #contact-cards-{{ section.id }} .cards-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  #contact-cards-{{ section.id }} .contact-card-item {
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none !important;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #contact-cards-{{ section.id }} .contact-card-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #contact-cards-{{ section.id }} .contact-card-item:hover {
    transform: translateY(-2px);
  }
  #contact-cards-{{ section.id }} .icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  #contact-cards-{{ section.id }} .icon-wrap svg {
    width: 20px;
    height: 20px;
    stroke-width: 1.8;
    fill:none;
  }
  #contact-cards-{{ section.id }} .card-title {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.792rem !important; /* Scaled 1.12rem * 1.6 */
    margin: 0 !important;
    line-height: 1.2 !important;
  }
  #contact-cards-{{ section.id }} .card-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.504rem !important; /* Scaled 0.94rem * 1.6 */
    line-height: 1.5 !important;
    margin: 0 !important;
    letter-spacing: normal;
  }
  #contact-cards-{{ section.id }} .card-link-lbl {
    margin-top: auto;
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.44rem !important; /* Scaled 0.9rem * 1.6 */
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 980px) {
    #contact-cards-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 620px) {
    #contact-cards-{{ section.id }} .cards-grid {
      grid-template-columns: 1fr !important;
    }
  }
{%- endstyle -%}

<section id="contact-cards-{{ section.id }}" class="yild-contact-cards-section">
  <div class="cards-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'contact_card' -%}
        {%- style -%}
          #contact-card-{{ block.id }} {
            background: {{ block.settings.card_bg }};
            color: {{ block.settings.card_txt }};
            {%- if block.settings.card_border != blank and block.settings.card_border != 'rgba(0,0,0,0)' -%}
              border: 1px solid {{ block.settings.card_border }};
            {%- endif -%}
            {%- if block.settings.enable_shadow -%}
              box-shadow: 0 10px 30px rgba(31, 61, 43, 0.05);
            {%- endif -%}
          }
          #contact-card-{{ block.id }} .card-title{
            color:{{ block.settings.card_txt }} !important;
          }
          #contact-card-{{ block.id }} .icon-wrap {
            background: {{ block.settings.icon_bg }};
            color: {{ block.settings.icon_txt }};
          }
          #contact-card-{{ block.id }} .card-desc {
            color: {{ block.settings.card_desc_color }};
          }
          #contact-card-{{ block.id }} .card-link-lbl {
            color: {{ block.settings.link_color }};
          }
        {%- endstyle -%}
        <a id="contact-card-{{ block.id }}" class="contact-card-item" href="{{ block.settings.link_url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          <div class="icon-wrap">
            {%- if block.settings.icon_type == 'whatsapp' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9.1 8.4 8.6 8.6 0 0 1-3.7-.9L3 20l1-4.9a8.4 8.4 0 1 1 17-3.6Z"></path></svg>
            {%- elsif block.settings.icon_type == 'email' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m3 7 9 6 9-6"></path></svg>
            {%- elsif block.settings.icon_type == 'phone' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"></path></svg>
            {%- endif -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="card-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="card-desc">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.link_lbl != blank -%}
            <span class="card-link-lbl">{{ block.settings.link_lbl }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("contact-cards-{{ section.id }}");
      if (!section) return;

      const cards = section.querySelectorAll('.contact-card-item');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      cards.forEach(card => {
        observer.observe(card);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

