{%- style -%}
  #farmer-apply-{{ section.id }} {
    padding: clamp(58px, 7vw, 108px) clamp(20px, 4vw, 54px);
    background: {{ section.settings.bg_color }};
  }
  #farmer-apply-{{ section.id }} .apply-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  #farmer-apply-{{ section.id }} .apply-left-col {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #farmer-apply-{{ section.id }} .apply-left-col.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #farmer-apply-{{ section.id }} .steps-subtitle {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.216rem !important; /* Scaled 0.76rem * 1.6 */
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }} !important;
    margin: 0 0 12px 0 !important;
    line-height: 1.2 !important;
  }
  #farmer-apply-{{ section.id }} .steps-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.2rem, 3.6vw, 4.96rem) !important; /* Scaled clamp(2rem, 3.6vw, 3.1rem) */
    color: {{ section.settings.title_color }} !important;
    line-height: 1.06 !important;
    margin: 0 0 24px 0 !important;
  }
  #farmer-apply-{{ section.id }} .steps-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  #farmer-apply-{{ section.id }} .step-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  #farmer-apply-{{ section.id }} .step-number {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: {{ section.settings.step_num_bg }};
    color: {{ section.settings.step_num_txt }};
    display: grid;
    place-items: center;
    font-family: var(--title-font) !important;
    font-style: italic;
    font-weight: 500;
    font-size: 1.6rem !important; /* Scaled */
  }
  #farmer-apply-{{ section.id }} .step-content-box h3 {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.68rem !important; /* Scaled 1.05rem * 1.6 */
    color: {{ section.settings.title_color }} !important;
    margin: 0 0 4px 0 !important;
    line-height: 1.2 !important;
    letter-spacing:normal;
  }
  #farmer-apply-{{ section.id }} .step-content-box p {
    font-family: var(--font-family-1) !important;
    font-size: 1.52rem !important; /* Scaled 0.95rem * 1.6 */
    color: {{ section.settings.desc_color }} !important;
    line-height: 1.55 !important;
    margin: 0 !important;
    letter-spacing: normal;
    letter-spacing:normal;
  }
  #farmer-apply-{{ section.id }} .step-content-box p a {
    color: {{ section.settings.link_color }};
    font-weight: 600;
    text-decoration: none;
  }
  #farmer-apply-{{ section.id }} .step-content-box p a:hover {
    text-decoration: underline;
  }

  /* Form Container */
  #farmer-apply-{{ section.id }} .form-container-box {
    background: {{ section.settings.form_bg }};
    border: 1px solid {{ section.settings.form_border }};
    border-radius: 26px;
    padding: clamp(24px, 3.5vw, 40px);
    box-shadow: 0 20px 50px rgba(31, 61, 43, 0.08);
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }
  #farmer-apply-{{ section.id }} .form-container-box.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #farmer-apply-{{ section.id }} .form-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: 2.4rem !important; /* Scaled 1.5rem * 1.6 */
    color: {{ section.settings.title_color }} !important;
    margin: 0 !important;
    line-height: 1.2 !important;
  }
  #farmer-apply-{{ section.id }} .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  #farmer-apply-{{ section.id }} .form-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-family-1) !important;
    font-size: 1.36rem !important; /* Scaled 0.85rem * 1.6 */
    font-weight: 600 !important;
    color: {{ section.settings.label_color }};
  }
  #farmer-apply-{{ section.id }} .form-input {
    padding: 13px 16px !important;
    border-radius: 14px !important;
    border: 1.5px solid {{ section.settings.form_input_border }} !important;
    background: {{ section.settings.form_input_bg }} !important;
    font-family: var(--font-family-1) !important;
    font-size: 1.568rem !important; /* Scaled 0.98rem * 1.6 */
    color: {{ section.settings.form_input_txt }} !important;
    outline: none;
    letter-spacing: normal;
    transition: border-color 0.2s;
  }
  #farmer-apply-{{ section.id }} .form-input:focus {
    border-color: {{ section.settings.accent_color }} !important;
  }
  #farmer-apply-{{ section.id }} .form-textarea {
    resize: vertical;
  }
  #farmer-apply-{{ section.id }} .form-submit-btn {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.6rem !important; /* Scaled 1rem * 1.6 */
    padding: 15px !important;
    border-radius: 100px !important;
    background: {{ section.settings.btn_bg }} !important;
    color: {{ section.settings.btn_txt }} !important;
    border: none !important;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
    outline: none;
  }
  #farmer-apply-{{ section.id }} .form-submit-btn:hover {
    transform: scale(1.015);
    opacity: 0.95;
  }

  @media (max-width: 980px) {
    #farmer-apply-{{ section.id }} .apply-grid {
      grid-template-columns: 1fr !important;
      gap: clamp(32px, 5vw, 50px) !important;
    }
  }
  @media (max-width: 620px) {
    #farmer-apply-{{ section.id }} .form-row {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }
  }
{%- endstyle -%}

<section id="farmer-apply-{{ section.id }}" class="yild-farmer-apply-section">
  <div class="apply-grid">
    <div class="apply-left-col">
      {%- if section.settings.subtitle != blank -%}
        <span class="steps-subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="steps-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      <div class="steps-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step_timeline' -%}
            <div class="step-item" {{ block.shopify_attributes }}>
              <span class="step-number">{{ block.settings.step_index }}</span>
              <div class="step-content-box">
                {%- if block.settings.title != blank -%}
                  <h3>{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p>{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- assign formId = 'FarmerApplyForm-' | append: section.id -%}
    {%- form 'contact', id: formId, class: 'form-container-box' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status-success" tabindex="-1" autofocus style="color: #2f7d4f; font-weight: 600; font-size: 1.6rem; margin: 0; padding: 10px 0;">
          {{ section.settings.success_message }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-status form-status-error" style="color: #d01919; font-weight: 600; font-size: 1.6rem; margin: 0; padding: 10px 0;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <h3 class="form-title">{{ section.settings.form_title }}</h3>

      <div class="form-row">
        <label class="form-label" for="{{ formId }}-name">
          Your name
          <input
            type="text"
            name="contact[name]"
            id="{{ formId }}-name"
            class="form-input"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            required
            placeholder="{{ section.settings.placeholder_name }}"
          >
        </label>
        <label class="form-label" for="{{ formId }}-farm-name">
          Farm name
          <input
            type="text"
            name="contact[farm_name]"
            id="{{ formId }}-farm-name"
            class="form-input"
            required
            placeholder="{{ section.settings.placeholder_farm }}"
          >
        </label>
      </div>

      <div class="form-row">
        <label class="form-label" for="{{ formId }}-email">
          Email
          <input
            type="email"
            name="contact[email]"
            id="{{ formId }}-email"
            class="form-input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            placeholder="{{ section.settings.placeholder_email }}"
            aria-required="true"
          >
        </label>
        <label class="form-label" for="{{ formId }}-phone">
          Phone / WhatsApp
          <input
            type="tel"
            name="contact[phone]"
            id="{{ formId }}-phone"
            class="form-input"
            placeholder="{{ section.settings.placeholder_phone }}"
          >
        </label>
      </div>
      
      <label class="form-label" for="{{ formId }}-location">
        Where is your farm?
        <input
          type="text"
          name="contact[farm_location]"
          id="{{ formId }}-location"
          class="form-input"
          required
          placeholder="{{ section.settings.placeholder_location }}"
        >
      </label>

      <label class="form-label" for="{{ formId }}-produce">
        What do you grow or make?
        <textarea
          rows="4"
          name="contact[body]"
          id="{{ formId }}-produce"
          class="form-input form-textarea"
          required
          placeholder="{{ section.settings.placeholder_produce }}"
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </label>

      <button type="submit" class="form-submit-btn">
        {{ section.settings.btn_lbl }}
      </button>
    {%- endform -%}
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("farmer-apply-{{ section.id }}");
      if (!section) return;

      const left = section.querySelector('.apply-left-col');
      const form = section.querySelector('.form-container-box');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      if (left) observer.observe(left);
      if (form) observer.observe(form);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

