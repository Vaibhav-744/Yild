<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500;1,6..72,600&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
  .yild-collection-hero-section {
    padding: clamp(56px, 7vw, 96px) clamp(20px, 4vw, 54px) clamp(30px, 4vw, 48px);
    background: var(--yild-cream, #f7f5ed);
    margin: 0;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
  }
  .yild-collection-hero-section .hero-inner-container {
    max-width: 1440px;
    margin: 0 auto;
  }
  .yild-collection-hero-section .hero-breadcrumb-nav {
    font-size: 13px;
    color: var(--yild-text-muted, #5d6b60);
    margin-bottom: 16px;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    line-height: 1.4;
  }
  .yild-collection-hero-section .hero-breadcrumb-nav a {
    color: var(--yild-green-muted, #4e7355);
    text-decoration: none;
  }
  .yild-collection-hero-section h1.hero-main-title,
  .yild-collection-hero-section #colTitle {
    font-family: var(--font-family-2, var(--title-font, 'Newsreader', serif));
    font-style: italic;
    font-weight: 500;
    font-size: clamp(38px, 5vw, 67px);
    line-height: 1.04;
    color: var(--yild-green-dark, #1f3d2b);
    margin: 0 0 14px 0;
    padding: 0;
    letter-spacing: normal;
    text-transform: none;
  }
  .yild-collection-hero-section .hero-desc-text {
    font-size: 17px;
    color: var(--yild-text-muted, #5d6b60);
    line-height: 1.6;
    max-width: 58ch;
    margin: 0;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
  }
  .yild-collection-hero-section .hero-desc-text p {
    font-size: 17px;
    color: var(--yild-text-muted, #5d6b60);
    line-height: 1.6;
    margin: 0;
  }
  .yild-collection-hero-section .hero-count-badge,
  .yild-collection-hero-section #colCount {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--yild-green-muted, #4e7355);
    margin-top: 18px;
    margin-bottom: 0;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
  }
</style>

<section class="yild-collection-hero-section" data-screen-label="Collection hero">
  <div class="hero-inner-container">
    {%- if section.settings.show_breadcrumb -%}
      <nav aria-label="Breadcrumb" class="hero-breadcrumb-nav">
        <a href="{{ routes.root_url }}">Home</a> · <span>Shop</span>
      </nav>
    {%- endif -%}
    
    <h1 id="colTitle" class="hero-main-title">
      {{ collection.title | escape }}
    </h1>

    <div class="hero-desc-text">
      {%- if collection.description != blank -%}
        {{ collection.description }}
      {%- else -%}
        Everything for your weekly shop, sourced direct from local growers, picked fresh and delivered with care.
      {%- endif -%}
    </div>

    <p id="colCount" class="hero-count-badge">
      {{ collection.all_products_count | default: collection.products_count }} PRODUCTS
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Yild Collection Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Yild Collection Hero"
    }
  ]
}
{% endschema %}
