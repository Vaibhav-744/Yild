{%- style -%}
  #contact-form-{{ section.id }} {
    padding: clamp(40px, 5vw, 72px) clamp(20px, 4vw, 54px) clamp(58px, 7vw, 96px);
    background: {{ section.settings.bg_color }};
  }
  #contact-form-{{ section.id }} .form-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  #contact-form-{{ section.id }} .form-left-col {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #contact-form-{{ section.id }} .form-left-col.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #contact-form-{{ section.id }} .info-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(2.88rem, 3.2vw, 4.16rem) !important; /* Scaled clamp(1.8rem, 3.2vw, 2.6rem) */
    color: {{ section.settings.title_color }} !important;
    line-height: 1.08 !important;
    margin: 0 0 16px 0 !important;
  }
  #contact-form-{{ section.id }} .info-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.632rem !important; /* Scaled 1.02rem * 1.6 */
    color: {{ section.settings.desc_color }} !important;
    line-height: 1.65 !important;
    margin: 0 0 22px 0 !important;
    letter-spacing:normal;
  }
  #contact-form-{{ section.id }} .info-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-family: var(--font-family-1) !important;
    font-size: 1.568rem !important; /* Scaled 0.98rem * 1.6 */
    color: {{ section.settings.checklist_color }} !important;
    margin: 0 0 22px 0 !important;
    padding: 0;
  }
  #contact-form-{{ section.id }} .info-check-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.4 !important;
  }
  #contact-form-{{ section.id }} .info-checkmark {
    color: {{ section.settings.accent_color }} !important;
    font-weight: 700;
  }
  #contact-form-{{ section.id }} .social-links-wrap {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }
  #contact-form-{{ section.id }} .social-link-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid {{ section.settings.border_color }};
    color: {{ section.settings.title_color }};
    transition: background 0.25s, color 0.25s, border-color 0.25s;
  }
  #contact-form-{{ section.id }} .social-link-btn[aria-label="Yild on Facebook"] svg{
    stroke:none;
  }
  #contact-form-{{ section.id }} .social-link-btn[aria-label="Yild on Instagram"] svg{
    fill:none;
  }
  #contact-form-{{ section.id }} .social-link-btn:hover {
    background: {{ section.settings.title_color }};
    color: {{ section.settings.bg_color }};
    border-color: {{ section.settings.title_color }};
  }
  #contact-form-{{ section.id }} .social-link-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Form Styling */
  #contact-form-{{ section.id }} .form-container-box {
    background: {{ section.settings.form_bg }};
    border: 1px solid {{ section.settings.form_border }};
    border-radius: 26px;
    padding: clamp(24px, 3.5vw, 40px);
    box-shadow: 0 20px 50px rgba(31, 61, 43, 0.08);
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }
  #contact-form-{{ section.id }} .form-container-box.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #contact-form-{{ section.id }} .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  #contact-form-{{ section.id }} .form-label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--font-family-1) !important;
    font-size: 1.36rem !important; /* Scaled 0.85rem * 1.6 */
    font-weight: 600 !important;
    color: {{ section.settings.label_color }};
  }
  #contact-form-{{ section.id }} .form-input {
    padding: 13px 16px !important;
    border-radius: 14px !important;
    border: 1.5px solid {{ section.settings.form_input_border }} !important;
    background: {{ section.settings.form_input_bg }} !important;
    font-family: var(--font-family-1) !important;
    font-size: 1.568rem !important; /* Scaled 0.98rem * 1.6 */
    color: {{ section.settings.form_input_txt }} !important;
    outline: none;
    letter-spacing: normal;
    transition: border-color 0.2s;
  }
  #contact-form-{{ section.id }} .form-input:focus {
    border-color: {{ section.settings.accent_color }} !important;
  }
  #contact-form-{{ section.id }} .form-textarea {
    resize: vertical;
  }
  #contact-form-{{ section.id }} .form-submit-btn {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.6rem !important; /* Scaled 1rem * 1.6 */
    padding: 15px !important;
    border-radius: 100px !important;
    background: {{ section.settings.btn_bg }} !important;
    color: {{ section.settings.btn_txt }} !important;
    border: none !important;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s;
    outline: none;
  }
  #contact-form-{{ section.id }} .form-submit-btn:hover {
    transform: scale(1.015);
    opacity: 0.95;
  }

  @media (max-width: 980px) {
    #contact-form-{{ section.id }} .form-grid {
      grid-template-columns: 1fr !important;
      gap: clamp(32px, 5vw, 50px) !important;
    }
  }
  @media (max-width: 620px) {
    #contact-form-{{ section.id }} .form-row {
      grid-template-columns: 1fr !important;
      gap: 16px !important;
    }
  }
{%- endstyle -%}

<section id="contact-form-{{ section.id }}" class="yild-contact-form-section">
  <div class="form-grid">
    <div class="form-left-col">
      {%- if section.settings.title != blank -%}
        <h2 class="info-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="info-desc">{{ section.settings.description }}</p>
      {%- endif -%}
      
      <ul class="info-checklist">
        {%- for block in section.blocks -%}
          {%- if block.type == 'bullet_point' -%}
            <li class="info-check-item" {{ block.shopify_attributes }}>
              <span class="info-checkmark">✓</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="social-links-wrap">
        {%- if section.settings.fb_url != blank -%}
          <a href="{{ section.settings.fb_url }}" target="_blank" rel="noopener" class="social-link-btn" aria-label="Yild on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 9H16l.5-3h-3V4.5c0-.9.3-1.5 1.6-1.5H16.6V.2C16.3.2 15.3 0 14.1 0 11.6 0 10 1.5 10 4.2V6H7.5v3H10v9h3.5V9z"></path></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.ig_url != blank -%}
          <a href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" class="social-link-btn" aria-label="Yild on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"></circle></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- assign formId = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: formId, class: 'form-container-box' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status-success" tabindex="-1" autofocus style="color: #2f7d4f; font-weight: 600; font-size: 1.6rem; margin: 0; padding: 10px 0;">
          {{ section.settings.success_message }}
        </p>
      {%- elsif form.errors -%}
        <div class="form-status form-status-error" style="color: #d01919; font-weight: 600; font-size: 1.6rem; margin: 0; padding: 10px 0;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="form-row">
        <label class="form-label" for="{{ formId }}-name">
          Your name
          <input
            type="text"
            name="contact[name]"
            id="{{ formId }}-name"
            class="form-input"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            required
            placeholder="{{ section.settings.placeholder_name }}"
          >
        </label>
        <label class="form-label" for="{{ formId }}-email">
          Email
          <input
            type="email"
            name="contact[email]"
            id="{{ formId }}-email"
            class="form-input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            placeholder="{{ section.settings.placeholder_email }}"
            aria-required="true"
          >
        </label>
      </div>
      
      <label class="form-label" for="{{ formId }}-subject">
        Subject
        <input
          type="text"
          name="contact[subject]"
          id="{{ formId }}-subject"
          class="form-input"
          required
          placeholder="{{ section.settings.placeholder_subject }}"
        >
      </label>

      <label class="form-label" for="{{ formId }}-message">
        Message
        <textarea
          rows="5"
          name="contact[body]"
          id="{{ formId }}-message"
          class="form-input form-textarea"
          required
          placeholder="{{ section.settings.placeholder_message }}"
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </label>

      <button type="submit" class="form-submit-btn">
        {{ section.settings.btn_lbl }}
      </button>
    {%- endform -%}
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("contact-form-{{ section.id }}");
      if (!section) return;

      const left = section.querySelector('.form-left-col');
      const form = section.querySelector('.form-container-box');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      if (left) observer.observe(left);
      if (form) observer.observe(form);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

