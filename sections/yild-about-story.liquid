{%- style -%}
  #yild-about-story-{{ section.id }} {
    padding: clamp(58px, 7vw, 108px) clamp(20px, 4vw, 54px);
    background: {{ section.settings.bg_color }};
  }
  #yild-about-story-{{ section.id }} .story-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  #yild-about-story-{{ section.id }} .story-left-col,
  #yild-about-story-{{ section.id }} .story-right-col {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-about-story-{{ section.id }} .story-left-col.is-revealed,
  #yild-about-story-{{ section.id }} .story-right-col.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-about-story-{{ section.id }} .story-subtitle {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.216rem !important; /* Scaled 0.76rem * 1.6 */
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase !important;
    color: {{ section.settings.subtitle_color }} !important;
    margin-bottom: 12px;
  }
  #yild-about-story-{{ section.id }} .story-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.2rem, 3.6vw, 4.96rem) !important; /* Scaled clamp(2rem, 3.6vw, 3.1rem) * 1.6 */
    color: {{ section.settings.title_color }} !important;
    line-height: 1.06 !important;
    margin: 0 !important;
  }
  #yild-about-story-{{ section.id }} .story-right-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-family: var(--font-family-1) !important;
    font-size: 1.728rem !important; /* Scaled 1.08rem * 1.6 */
    line-height: 1.7 !important;
    color: {{ section.settings.text_color }} !important;
    transition-delay: 120ms;
  }
  #yild-about-story-{{ section.id }} .story-right-col p {
    margin: 0 !important;
  }

  @media (max-width: 980px) {
    #yild-about-story-{{ section.id }} .story-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
{%- endstyle -%}

<section id="yild-about-story-{{ section.id }}" class="yild-about-story-section">
  <div class="story-grid">
    <div class="story-left-col">
      {%- if section.settings.subtitle != blank -%}
        <span class="story-subtitle">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="story-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    <div class="story-right-col">
      {{ section.settings.story_content }}
    </div>
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("yild-about-story-{{ section.id }}");
      if (!section) return;

      const leftCol = section.querySelector('.story-left-col');
      const rightCol = section.querySelector('.story-right-col');

      if (observer) observer.disconnect();

      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (leftCol) leftCol.classList.add('is-revealed');
            if (rightCol) rightCol.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      observer.observe(section);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Yild About Story",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ed"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#4e7355"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#3a4a3d"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why we exist"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Food is better when you know where it grew — and who grew it."
    },
    {
      "type": "richtext",
      "id": "story_content",
      "label": "Story Content",
      "default": "<p>Yild started with a simple frustration: supermarket \"fresh\" isn't fresh. Produce sits in cold storage for weeks while the farmers who grew it are squeezed on price. We knew both sides deserved better.</p><p>So we built a shorter route. We partner directly with local growers, collect from the farm, and deliver to your door every Sunday — no warehouses, no middlemen, no week-long waits. Farmers set fair prices and keep more of them. You get food picked at its peak, often harvested the very morning it reaches you.</p><p>And because good food should be for everyone, we donate fresh, local produce for every Vegetable Box sold — supporting families in the same communities we deliver to.</p>"
    }
  ],
  "presets": [
    {
      "name": "Yild About Story"
    }
  ]
}
{% endschema %}
