{%- style -%}
  #yild-stats-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: clamp(58px, 7vw, 100px) clamp(20px, 5vw, 54px);
  }
  #yild-stats-{{ section.id }} .story-wrap {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(30px, 5vw, 68px);
    align-items: center;
  }
  @media (max-width: 980px) {
    #yild-stats-{{ section.id }} .story-wrap {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
  #yild-stats-{{ section.id }} .story-subtitle {
    display: inline-block;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    font-size: 1.216rem; /* Scaled 0.76rem * 1.6 */
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 18px;
  }
  #yild-stats-{{ section.id }} .story-title {
    font-family: var(--font-family-2, var(--title-font, 'Newsreader', serif));
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.2rem, 3.8vw, 4.96rem);
    line-height: 1.1;
    margin: 0;
    color: {{ section.settings.title_color }};
  }
  #yild-stats-{{ section.id }} .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  #yild-stats-{{ section.id }} .stat-card {
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 18px;
    padding: 22px;
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-stats-{{ section.id }} .stat-card.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-stats-{{ section.id }} .stat-number {
    font-family: var(--font-family-2, var(--title-font, 'Newsreader', serif));
    font-weight: 500;
    font-size: 3.68rem;
    color: #ffffff;
  }
  #yild-stats-{{ section.id }} .stat-desc {
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    font-size: 1.44rem;
    color: {{ section.settings.text_color_muted }};
    margin: 4px 0 0 0;
  }
  #yild-stats-{{ section.id }} .story-text-col {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-stats-{{ section.id }} .story-text-col.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
{%- endstyle -%}

<section id="yild-stats-{{ section.id }}" class="yild-stats-section">
  <div class="story-wrap">
    <div class="story-text-col">
      {%- if section.settings.subtitle != blank -%}
        <span class="story-subtitle eyebrow-text">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="story-title">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>
    
    <div class="stats-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div class="stat-card" style="transition-delay: {{ forloop.index0 | times: 90 }}ms;" {{ block.shopify_attributes }}>
            <div class="stat-number" data-count="{{ block.settings.value }}" data-suffix="{{ block.settings.suffix }}">
              0{{ block.settings.suffix }}
            </div>
            {%- if block.settings.desc != blank -%}
              <p class="stat-desc">{{ block.settings.desc }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("yild-stats-{{ section.id }}");
      if (!section) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const textCol = section.querySelector('.story-text-col');
      const cards = section.querySelectorAll('.stat-card');

      if (observer) observer.disconnect();

      // Reveal elements on scroll
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (textCol) textCol.classList.add('is-revealed');
            cards.forEach(card => {
              card.classList.add('is-revealed');
              const numEl = card.querySelector('.stat-number');
              if (numEl && !numEl.classList.contains('counted')) {
                numEl.classList.add('counted');
                runCounter(numEl);
              }
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });

      observer.observe(section);

      function runCounter(el) {
        const target = parseFloat(el.dataset.count);
        const suffix = el.dataset.suffix || '';
        if (reduce || isNaN(target)) {
          el.textContent = el.dataset.count + suffix;
          return;
        }
        
        const duration = 1500;
        const start = performance.now();
        const ease = (t) => 1 - Math.pow(1 - t, 3);
        
        const step = (now) => {
          const t = Math.min(1, (now - start) / duration);
          el.textContent = Math.round(target * ease(t)) + suffix;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Yild Stats Promise",
  "max_blocks": 6,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "General Text Color",
      "default": "#f1efe3"
    },
    {
      "type": "color",
      "id": "text_color_muted",
      "label": "Muted Text Color",
      "default": "rgba(241, 239, 227, 0.74)"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#a9c4ac"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card Border Color",
      "default": "rgba(241, 239, 227, 0.18)"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From the farm to your table"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Section Title",
      "default": "Know your food — from the soil it grew in to the score on its label."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Block",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat Number/Value",
          "default": "100"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "%"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Traceable to the farm"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yild Stats Promise",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "100",
            "suffix": "%",
            "desc": "Traceable to the farm"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "0",
            "suffix": "",
            "desc": "Middlemen in between"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "10",
            "suffix": "k+",
            "desc": "Products health-scored"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "24",
            "suffix": "h",
            "desc": "Field to doorstep, Kent"
          }
        }
      ]
    }
  ]
}
{% endschema %}
