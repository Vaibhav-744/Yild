{%- style -%}
  #yild-article-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px clamp(20px, 4vw, 54px) {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  #yild-article-{{ section.id }} .article-header {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }
  #yild-article-{{ section.id }} .article-eyebrow {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.248rem !important; /* Scaled 0.78rem * 1.6 */
    font-weight: 600 !important;
    letter-spacing: 0.2em !important;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }} !important;
    margin: 0 0 16px 0 !important;
    line-height: 1.2 !important;
  }
  #yild-article-{{ section.id }} .article-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.2rem, 5vw, 5.76rem) !important; /* Scaled clamp(2rem, 5vw, 3.6rem) */
    line-height: 1.08 !important;
    color: {{ section.settings.title_color }} !important;
    margin: 0 0 20px 0 !important;
    letter-spacing: normal;
  }
  #yild-article-{{ section.id }} .article-meta {
    font-family: var(--font-family-1) !important;
    font-size: 1.44rem !important; /* Scaled 0.9rem * 1.6 */
    color: {{ section.settings.meta_color }} !important;
    margin-bottom: clamp(30px, 5vw, 48px);
    line-height: 1.4 !important;
  }

  /* Main Featured Image */
  #yild-article-{{ section.id }} .article-image-container {
    max-width: 1100px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(31, 61, 43, 0.08);
  }
  #yild-article-{{ section.id }} .article-featured-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Body Content Columns */
  #yild-article-{{ section.id }} .article-content-body {
    max-width: 740px;
    margin: 0 auto;
  }
  #yild-article-{{ section.id }} .article-rich-text {
    font-family: var(--font-family-1) !important;
    font-size: 1.6rem !important; /* Scaled 1rem * 1.6 */
    line-height: 1.75 !important;
    color: {{ section.settings.text_color }} !important;
  }
  #yild-article-{{ section.id }} .article-rich-text p {
    margin: 0 0 24px 0 !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
    letter-spacing: normal !important;
  }
  #yild-article-{{ section.id }} .article-rich-text h2 {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    color: {{ section.settings.title_color }} !important;
    font-size: clamp(2.56rem, 3.5vw, 3.52rem) !important; /* Scaled clamp(1.6rem, 3.5vw, 2.2rem) */
    line-height: 1.2 !important;
    margin: 40px 0 16px 0 !important;
    letter-spacing: normal !important;
  }
  #yild-article-{{ section.id }} .article-rich-text h3 {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    color: {{ section.settings.title_color }} !important;
    font-size: clamp(2.08rem, 2.8vw, 2.88rem) !important; /* Scaled clamp(1.3rem, 2.8vw, 1.8rem) */
    line-height: 1.25 !important;
    margin: 32px 0 14px 0 !important;
    letter-spacing: normal !important;
  }
  #yild-article-{{ section.id }} .article-rich-text blockquote {
    border-left: 4px solid {{ section.settings.subtitle_color }} !important;
    background: #eef3ec !important;
    padding: 24px clamp(20px, 4vw, 32px) !important;
    margin: 36px 0 !important;
    border-radius: 12px;
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-size: clamp(1.76rem, 2.2vw, 2.24rem) !important; /* Scaled clamp(1.1rem, 2.2vw, 1.4rem) */
    line-height: 1.5 !important;
    color: {{ section.settings.title_color }} !important;
  }
  #yild-article-{{ section.id }} .article-rich-text ul,
  #yild-article-{{ section.id }} .article-rich-text ol {
    margin: 0 0 24px 24px !important;
    padding: 0 !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
  }
  #yild-article-{{ section.id }} .article-rich-text li {
    margin-bottom: 8px !important;
    font-family: inherit !important;
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
  }
  #yild-article-{{ section.id }} .article-rich-text a {
    color: {{ section.settings.subtitle_color }} !important;
    text-decoration: underline !important;
    font-weight: 600 !important;
  }
  #yild-article-{{ section.id }} .article-rich-text img {
    border-radius: 16px !important;
    margin: 32px auto !important;
    display: block !important;
    max-width: 100% !important;
    height: auto !important;
    box-shadow: 0 10px 25px rgba(31, 61, 43, 0.05) !important;
  }

  /* Back to Blog Action button */
  #yild-article-{{ section.id }} .article-back-nav {
    max-width: 740px;
    margin: clamp(48px, 8vw, 80px) auto 0;
    padding-top: 24px;
    border-top: 1px solid #e6ebe2;
  }
  #yild-article-{{ section.id }} .back-to-blog-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ section.settings.subtitle_color }};
    text-decoration: none !important;
    font-weight: 600 !important;
    font-size: 1.6rem !important;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-article-{{ section.id }} .back-to-blog-link:hover {
    transform: translateX(-4px);
  }
{%- endstyle -%}

<article id="yild-article-{{ section.id }}" class="yild-single-article-section">
  
  {%- assign category_tag = "" -%}
  {%- for tag in article.tags -%}
    {%- assign downcase_tag = tag | downcase -%}
    {%- unless downcase_tag == 'featured' -%}
      {%- assign category_tag = tag -%}
      {%- break -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- if category_tag == "" -%}
    {%- assign category_tag = blog.title -%}
  {%- endif -%}

  {%- assign words = article.content | strip_html | number_of_words -%}
  {%- assign read_time = words | divided_by: 200 | at_least: 1 -%}

  <header class="article-header">
    <span class="article-eyebrow">{{ category_tag }}</span>
    <h1 class="article-title">{{ article.title }}</h1>
    
    <div class="article-meta">
      {%- if section.settings.show_author -%}
        By {{ article.author }}
      {%- endif -%}
      {%- if section.settings.show_author and section.settings.show_date -%}
        ·
      {%- endif -%}
      {%- if section.settings.show_date -%}
        {{ article.published_at | date: '%B %d, %Y' }}
      {%- endif -%}
      · {{ read_time }} min read
    </div>
  </header>

  {%- if article.image != blank -%}
    <div class="article-image-container">
      {{ article.image | image_url: width: 1500 | image_tag: class: 'article-featured-img', loading: 'eager', alt: article.title | escape }}
    </div>
  {%- endif -%}

  <div class="article-content-body">
    <div class="article-rich-text">
      {{ article.content }}
    </div>

    {%- if section.settings.show_back_to_blog -%}
      <div class="article-back-nav">
        <a href="{{ blog.url }}" class="back-to-blog-link">
          {{ section.settings.back_to_blog_text }}
        </a>
      </div>
    {%- endif -%}
  </div>

</article>

{% schema %}
{
  "name": "Yild Single Article",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ed"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Eyebrow & Link Color",
      "default": "#4e7355"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Content Text Color",
      "default": "#1f3d2b"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Metadata Color",
      "default": "#5d6b60"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show Author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Published Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_back_to_blog",
      "label": "Show Back to Blog Link",
      "default": true
    },
    {
      "type": "text",
      "id": "back_to_blog_text",
      "label": "Back to Blog Text",
      "default": "← Back to Blog"
    },
    {
      "type": "header",
      "content": "Spacing Options"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 80
    }
  ]
}
{% endschema %}
