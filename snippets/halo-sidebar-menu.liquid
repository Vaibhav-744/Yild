<div class="halo-sidebar halo-sidebar-left halo-sidebar_menu" id="navigation-mobile">
  <div class="halo-sidebar-wrapper custom-scrollbar">
    <!-- Header Bar -->
    <div class="menu-heading-mobile halo-sidebar-header">
      <span class="title">{{ 'general.common.menu' | t | default: "Menu" }}</span>
      <button type="button" class="halo-sidebar-close" data-menu-close-sidebar aria-label="{{ 'general.common.close' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- Mobile Navigation List Body -->
    <nav class="yild-mobile-nav-body">
      <ul class="yild-mobile-menu-list">
        {%- assign mobile_linklist = linklists['main-menu'] -%}

        {%- if mobile_linklist != blank and mobile_linklist.links.size > 0 -%}
          {%- for link in mobile_linklist.links -%}
            {%- assign link_title_clean = link.title | downcase | strip -%}
            
            {%- if link.links != blank or link_title_clean == 'shop' or link_title_clean == 'catalog' -%}
              <li class="yild-mobile-menu-item yild-mobile-section-header">
                <span class="yild-mobile-section-title">{{ link.title | uppercase }}</span>
                <ul class="yild-mobile-submenu-list">
                  {%- if link.links != blank -%}
                    {%- for child_link in link.links -%}
                      <li class="yild-mobile-subitem">
                        <a href="{{ child_link.url }}" class="yild-mobile-sublink">{{ child_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Fruit & Veg</a></li>
                    <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Vegetable Boxes</a></li>
                    <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Babycare</a></li>
                    <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Body Care</a></li>
                    <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Milk Non-Dairy</a></li>
                  {%- endif -%}
                </ul>
              </li>
            {%- else -%}
              <li class="yild-mobile-menu-item">
                <a href="{{ link.url }}" class="yild-mobile-mainlink">{{ link.title }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <li class="yild-mobile-menu-item"><a href="/" class="yild-mobile-mainlink">Home</a></li>
          <li class="yild-mobile-menu-item yild-mobile-section-header">
            <span class="yild-mobile-section-title">SHOP</span>
            <ul class="yild-mobile-submenu-list">
              <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Fruit & Veg</a></li>
              <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Vegetable Boxes</a></li>
              <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Babycare</a></li>
              <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Body Care</a></li>
              <li class="yild-mobile-subitem"><a href="/collections/all" class="yild-mobile-sublink">Milk Non-Dairy</a></li>
            </ul>
          </li>
          <li class="yild-mobile-menu-item"><a href="/pages/about-us" class="yild-mobile-mainlink">About Us</a></li>
          <li class="yild-mobile-menu-item"><a href="/pages/our-growers" class="yild-mobile-mainlink">Meet Our Growers</a></li>
          <li class="yild-mobile-menu-item"><a href="/blogs/news" class="yild-mobile-mainlink">Blog</a></li>
          <li class="yild-mobile-menu-item"><a href="/pages/meet-the-farmers" class="yild-mobile-mainlink">Meet the Farmers</a></li>
          <li class="yild-mobile-menu-item"><a href="/pages/become-a-farmer" class="yild-mobile-mainlink">Become a Farmer</a></li>
          <li class="yild-mobile-menu-item"><a href="/pages/faq" class="yild-mobile-mainlink">FAQ</a></li>
          <li class="yild-mobile-menu-item"><a href="/pages/contact" class="yild-mobile-mainlink">Contact</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- Bottom CTA Button -->
    <div class="yild-mobile-menu-footer">
      <a href="/collections/all" class="yild-mobile-cta-btn">
        Build Your Box
      </a>
    </div>
  </div>
</div>

<style>
  /* Yild Mobile Navigation Drawer Styling (0px - 1024px) */
  @media screen and (max-width: 1024px) {
    #navigation-mobile.halo-sidebar_menu {
      background: var(--yild-cream-bg, #f7f5ed);
      width: 320px;
      max-width: 85vw;
    }

    #navigation-mobile .halo-sidebar-wrapper {
      background: var(--yild-cream-bg, #f7f5ed);
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow-y: auto;
    }

    #navigation-mobile .menu-heading-mobile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 20px;
      margin-bottom: 12px;
      border-bottom: none;
      background: transparent;
    }

    #navigation-mobile .menu-heading-mobile .title {
      font-family: var(--font-family-2, 'Newsreader', serif);
      font-style: italic;
      font-weight: 500;
      font-size: 28px;
      color: var(--yild-green-dark, #16301f);
      text-transform: none;
      letter-spacing: normal;
    }

    #navigation-mobile .halo-sidebar-close {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.05);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      color: var(--yild-green-dark, #16301f);
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    #navigation-mobile .halo-sidebar-close:hover {
      background: rgba(0, 0, 0, 0.1);
    }

    #navigation-mobile .halo-sidebar-close svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
      stroke: currentColor;
    }

    .yild-mobile-nav-body {
      flex: 1;
      overflow-y: auto;
    }

    .yild-mobile-menu-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .yild-mobile-menu-item {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .yild-mobile-mainlink {
      font-family: var(--font-family-1, 'Figtree', sans-serif);
      font-weight: 600;
      font-size: 16px;
      color: var(--yild-green-dark, #16301f);
      padding: 8px 0;
      display: block;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .yild-mobile-mainlink:hover {
      color: var(--yild-green-hover, #4e7355);
    }

    .yild-mobile-section-header {
      margin-top: 14px;
      margin-bottom: 8px;
    }

    .yild-mobile-section-title {
      font-family: var(--font-family-1, 'Figtree', sans-serif);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--yild-green-dark, #4e7355);
      display: block;
      margin-bottom: 6px;
    }

    .yild-mobile-submenu-list {
      list-style: none;
      padding: 0 0 0 10px;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .yild-mobile-subitem {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .yild-mobile-sublink {
      font-family: var(--font-family-1, 'Figtree', sans-serif);
      font-size: 15px;
      font-weight: 500;
      color: var(--yild-green-dark, #16301f);
      padding: 6px 0;
      display: block;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .yild-mobile-sublink:hover {
      color: var(--yild-green-hover, #4e7355);
    }

    .yild-mobile-menu-footer {
      margin-top: auto;
      padding-top: 24px;
    }

    .yild-mobile-cta-btn {
      display: block;
      width: 100%;
      background: var(--yild-green-dark, #1f3d2b);
      color: #ffffff;
      font-family: var(--font-family-1, 'Figtree', sans-serif);
      font-weight: 600;
      font-size: 15px;
      padding: 14px 20px;
      border-radius: 100px;
      text-align: center;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .yild-mobile-cta-btn:hover {
      background: var(--yild-green-hover, #16301f);
      color: #ffffff;
    }
  }
</style>