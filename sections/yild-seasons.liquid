{%- style -%}
  #yild-seasons-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: clamp(80px, 11vw, 160px) clamp(20px, 5vw, 54px);
  }
  #yild-seasons-{{ section.id }} .seasons-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 6vw, 84px);
    align-items: center;
  }
  @media (max-width: 980px) {
    #yild-seasons-{{ section.id }} .seasons-grid {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    #yild-seasons-{{ section.id }} .seasons-media {
      height: 74vw !important;
      min-height: 320px;
    }
  }
  #yild-seasons-{{ section.id }} .editorial-col {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #yild-seasons-{{ section.id }} .editorial-col.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #yild-seasons-{{ section.id }} .seasons-subtitle {
    display: inline-block;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    font-size: 1.216rem; /* Scaled 0.76rem * 1.6 */
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }};
    margin-bottom: 18px;
  }
  #yild-seasons-{{ section.id }} .seasons-title {
    font-family: var(--font-family-2, var(--title-font, 'Newsreader', serif));
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.36rem, 4.2vw, 5.6rem);
    line-height: 1.06;
    margin: 0 0 20px 0;
    color: {{ section.settings.text_color }};
  }
  #yild-seasons-{{ section.id }} .seasons-desc {
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    font-size: 1.76rem;
    line-height: 1.65;
    color: {{ section.settings.text_color_muted }};
    max-width: 46ch;
    margin: 0 0 14px 0;
  }
  #yild-seasons-{{ section.id }} .seasons-desc:last-of-type {
    margin-bottom: 28px;
  }
  #yild-seasons-{{ section.id }} .seasons-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-1, 'Figtree', sans-serif);
    font-weight: 600;
    font-size: 1.44rem;
    padding: 14px 30px;
    border-radius: 100px;
    background: {{ section.settings.btn_bg_color }};
    color: {{ section.settings.btn_txt_color }};
    text-decoration: none;
    min-width: 0;
    width: auto;
    height: auto;
    line-height: 1.2 !important;
    border: none !important;
    transition: transform 0.25s cubic-bezier(.16,1,.3,1), background-color 0.25s !important;
    will-change: transform !important;
  }
  #yild-seasons-{{ section.id }} .seasons-media {
    position: relative;
    height: min(580px, 72vh);
  }
  #yild-seasons-{{ section.id }} .media-box-1 {
    position: absolute;
    top: 0;
    right: 0;
    width: 74%;
    height: 78%;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(8, 20, 10, 0.4);
  }
  #yild-seasons-{{ section.id }} .media-box-1 img {
    width: 100%;
    height: 118%;
    object-fit: cover;
    position: relative;
    top: -9%;
    will-change: transform;
  }
  #yild-seasons-{{ section.id }} .media-box-2 {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 56%;
    height: 58%;
    border-radius: 20px;
    overflow: hidden;
    border: 7px solid {{ section.settings.bg_color }};
    box-shadow: 0 24px 54px rgba(8, 20, 10, 0.45);
  }
  #yild-seasons-{{ section.id }} .media-box-2 img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    position: relative;
    top: -10%;
    will-change: transform;
  }
  #yild-seasons-{{ section.id }} .score-badge {
    position: absolute;
    top: 8%;
    left: -4%;
    display: flex;
    align-items: center;
    gap: 11px;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_txt_color }};
    padding: 13px 18px;
    border-radius: 16px;
    box-shadow: 0 18px 40px rgba(8, 20, 10, 0.35);
    will-change: transform;
  }
  #yild-seasons-{{ section.id }} .score-badge-number {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-family-2);
    font-style: italic;
    font-weight: 500;
    font-size: 1.68rem;
    color: {{ section.settings.badge_score_color }};
    background: {{ section.settings.badge_score_bg }};
    border: 2px solid {{ section.settings.badge_score_border }};
  }
  #yild-seasons-{{ section.id }} .score-badge-text {
    line-height: 1.2;
  }
  #yild-seasons-{{ section.id }} .score-badge-title {
    font-family: var(--font-family-1) !important;
    font-weight: 700 !important;
    font-size: 1.52rem !important;
  }
  #yild-seasons-{{ section.id }} .score-badge-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.248rem !important;
    color: {{ section.settings.badge_desc_color }} !important;
  }
{%- endstyle -%}

<section id="yild-seasons-{{ section.id }}" class="yild-seasons-section">
  <div class="seasons-grid">
    <div class="editorial-col">
      {%- if section.settings.subtitle != blank -%}
        <span class="seasons-subtitle eyebrow-text">{{ section.settings.subtitle }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="seasons-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.desc1 != blank -%}
        <p class="seasons-desc">{{ section.settings.desc1 }}</p>
      {%- endif -%}
      {%- if section.settings.desc2 != blank -%}
        <p class="seasons-desc">{{ section.settings.desc2 }}</p>
      {%- endif -%}
      {%- if section.settings.btn_lbl != blank -%}
        <a href="{{ section.settings.btn_url }}" class="seasons-cta custom-button" data-magnetic="0.3">{{ section.settings.btn_lbl }}</a>
      {%- endif -%}
    </div>
    
    <div class="seasons-media">
      <!-- Media 1 -->
      <div class="media-box-1">
        {%- if section.settings.image_1 != blank -%}
          <img data-parallax="0.05" src="{{ section.settings.image_1 | image_url: width: 800 }}" alt="{{ section.settings.image_1.alt | escape }}">
        {%- else -%}
          <img data-parallax="0.05" src="https://images.unsplash.com/photo-1542838132-92c53300491e?w=800&q=80" alt="Farm shop display">
        {%- endif -%}
      </div>

      <!-- Media 2 -->
      <div class="media-box-2">
        {%- if section.settings.image_2 != blank -%}
          <img data-parallax="-0.06" src="{{ section.settings.image_2 | image_url: width: 600 }}" alt="{{ section.settings.image_2.alt | escape }}">
        {%- else -%}
          <img data-parallax="-0.06" src="https://images.unsplash.com/photo-1595855759920-86582396756a?w=600&q=80" alt="Harvest crate">
        {%- endif -%}
      </div>

      <!-- Score Badge Card -->
      <div class="score-badge" data-parallax="0.11">
        <span class="score-badge-number">{{ section.settings.badge_score }}</span>
        <div class="score-badge-text">
          <div class="score-badge-title">{{ section.settings.badge_title }}</div>
          <div class="score-badge-desc">{{ section.settings.badge_desc }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    let observer = null;
    let rafId = null;

    function init() {
      const section = document.getElementById("yild-seasons-{{ section.id }}");
      if (!section) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const editorialCol = section.querySelector('.editorial-col');

      if (observer) observer.disconnect();

      // Scroll Reveal
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            if (editorialCol) editorialCol.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      
      observer.observe(section);

      // Parallax scrolling
      if (rafId) cancelAnimationFrame(rafId);
      
      if (!reduce) {
        const parallaxEls = section.querySelectorAll('[data-parallax]');

        const loop = () => {
          const vh = window.innerHeight;
          const vc = vh / 2;
          
          parallaxEls.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) return;
            const factor = parseFloat(el.dataset.parallax) || 0;
            const off = (r.top + r.height / 2 - vc) * factor;
            el.style.transform = 'translate3d(0,' + off.toFixed(2) + 'px,0)';
          });
          
          rafId = requestAnimationFrame(loop);
        };
        
        rafId = requestAnimationFrame(loop);
      }

      // Magnetic button effect (disabled for now)
      /*
      const magneticBtn = section.querySelector('[data-magnetic]');
      if (magneticBtn) {
        const strength = parseFloat(magneticBtn.dataset.magnetic) || 0.3;
        magneticBtn.style.transition = 'transform .25s cubic-bezier(.16,1,.3,1)';
        magneticBtn.style.willChange = 'transform';
        
        // Remove existing listeners to avoid multiple bindings
        const newBtn = magneticBtn.cloneNode(true);
        magneticBtn.parentNode.replaceChild(newBtn, magneticBtn);
        
        newBtn.addEventListener('pointermove', (e) => {
          const r = newBtn.getBoundingClientRect();
          const mx = e.clientX - (r.left + r.width / 2);
          const my = e.clientY - (r.top + r.height / 2);
          newBtn.style.transform = 'translate(' + (mx * strength) + 'px,' + (my * strength) + 'px)';
        });
        
        newBtn.addEventListener('pointerleave', () => {
          newBtn.style.transform = 'translate(0,0)';
        });
      }
      */
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
        cancelAnimationFrame(rafId);
      }
    });
  })();
</script>

