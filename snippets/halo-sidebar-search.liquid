<div class="halo-sidebar halo-sidebar-left halo-sidebar_search" id="search-form-mobile">
    <div class="halo-sidebar-header text-left">
      <span class="title">{{ 'general.search.search' | t | default: 'Search' }}</span>
      <button type="button" class="halo-sidebar-close" data-search-close-sidebar aria-label="{{ 'general.common.close' | t }}">{% render 'icon-close' %}</button>
    </div>
    <div class="halo-sidebar-wrapper custom-scrollbar">
        <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}" data-product-to-show="{{ settings.quick_search_to_show }}">
            <details class="search_details" open>
                <summary class="header__search-full" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}" style="display:none;"></summary>
                <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                    <div class="field">
                        <input class="search__input field__input form-input-placeholder" id="Search-In-Modal-Sidebar" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search_product' | t | default: 'Search...' }}" autocomplete="off" {%- if settings.show_quick_search -%}role="combobox" aria-expanded="false" aria-owns="predictive-search-results-list" aria-controls="predictive-search-results-list" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false"{%- endif -%}>
                        <input type="hidden" name="options[prefix]" value="last">
                        <label class="field__label hiddenLabels" for="Search-In-Modal-Sidebar">{{ 'general.search.search' | t }}</label>
                        <button class="button search__button field__button focus-inset" aria-label="{{ 'general.search.search' | t }}">{% render 'icon-search' %}</button>
                    </div>
                    {%- if settings.show_quick_search -%}
                        {%- if settings.show_search_trending or settings.show_search_product -%}
                            {%- render 'quick-searching-trending-products', sectionId: 'sidebar-search-list-result' -%}
                        {%- endif -%}
                        {%- render 'predictive-search-results' -%}
                    {%- endif -%}
                </form>
            </details>
        </predictive-search>
    </div>
</div>

<style>
  /* Yild Mobile Search Sidebar Drawer (.halo-sidebar_search) Styling */
  .halo-sidebar.halo-sidebar_search,
  #search-form-mobile {
    background: var(--yild-cream-bg, #f7f5ed) !important;
    width: 340px !important;
    max-width: 88vw !important;
  }

  .halo-sidebar_search .halo-sidebar-header {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    padding: 24px 20px 16px !important;
    border-bottom: none !important;
    background: var(--yild-cream-bg, #f7f5ed) !important;
    position: relative !important;
  }

  .halo-sidebar_search .halo-sidebar-header .title {
    font-family: var(--font-family-2, 'Newsreader', serif) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: 28px !important;
    color: var(--yild-green-dark, #16301f) !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }

  .halo-sidebar_search .halo-sidebar-close {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: rgba(0, 0, 0, 0.05) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    color: var(--yild-green-dark, #16301f) !important;
    padding: 0 !important;
    cursor: pointer !important;
    transition: background 0.2s ease !important;
  }

  .halo-sidebar_search .halo-sidebar-close:hover {
    background: rgba(0, 0, 0, 0.1) !important;
  }

  .halo-sidebar_search .halo-sidebar-close svg {
    width: 16px !important;
    height: 16px !important;
    fill: currentColor !important;
    stroke: currentColor !important;
  }

  .halo-sidebar_search .halo-sidebar-wrapper {
    background: var(--yild-cream-bg, #f7f5ed) !important;
    padding: 0 20px 30px !important;
    display: flex !important;
    flex-direction: column !important;
    height: calc(100% - 75px) !important;
    overflow-y: auto !important;
  }

  .halo-sidebar_search .search-modal__form,
  .halo-sidebar_search .search_details,
  .halo-sidebar_search form.search {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  .halo-sidebar_search .field {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    width: 100% !important;
    background: #ffffff !important;
    border-radius: 100px !important;
    padding: 4px 6px 4px 20px !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08) !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-sizing: border-box !important;
    margin-bottom: 16px !important;
  }

  .halo-sidebar_search .field .search__input {
    width: 100% !important;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    font-family: var(--font-family-1, 'Figtree', sans-serif) !important;
    font-size: 15px !important;
    color: var(--yild-green-dark, #16301f) !important;
    padding: 10px 6px !important;
  }

  .halo-sidebar_search .field .search__input::placeholder {
    color: #8fa093 !important;
  }

  .halo-sidebar_search .field .search__button {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    border-radius: 50% !important;
    background: var(--yild-green-dark, #16301f) !important;
    border: none !important;
    color: #ffffff !important;
    padding: 0 !important;
    margin-left: auto !important;
    cursor: pointer !important;
    flex-shrink: 0 !important;
  }

  .halo-sidebar_search .field .search__button svg {
    width: 16px !important;
    height: 16px !important;
    fill: #ffffff !important;
    stroke: #ffffff !important;
  }

  .halo-sidebar_search .search-modal,
  .halo-sidebar_search .search_details .search-modal,
  .halo-sidebar_search details > .search-modal {
    position: relative !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    background: transparent !important;
    transform: none !important;
    display: block !important;
  }

  .halo-sidebar_search .quickSearchResultsWrap,
  .halo-sidebar_search .quickSearchResultsBlock,
  .halo-sidebar_search .quickSearchResults {
    position: relative !important;
    top: 0 !important;
    left: 0 !important;
    background: #ffffff !important;
    border-radius: 18px !important;
    padding: 20px !important;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
    margin-top: 10px !important;
  }
</style>