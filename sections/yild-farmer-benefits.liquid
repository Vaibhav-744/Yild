{%- style -%}
  #farmer-benefits-{{ section.id }} {
    padding: clamp(58px, 7vw, 100px) clamp(20px, 4vw, 54px);
    background: {{ section.settings.bg_color }};
  }
  #farmer-benefits-{{ section.id }} .benefits-header {
    text-align: center;
    max-width: 660px;
    margin: 0 auto clamp(34px, 4vw, 50px);
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #farmer-benefits-{{ section.id }} .benefits-header.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #farmer-benefits-{{ section.id }} .benefits-subtitle {
    display: inline-block;
    font-family: var(--font-family-1) !important;
    font-size: 1.216rem !important; /* Scaled 0.76rem * 1.6 */
    font-weight: 600 !important;
    letter-spacing: 0.16em !important;
    text-transform: uppercase;
    color: {{ section.settings.subtitle_color }} !important;
    margin: 0 0 12px 0 !important;
    line-height: 1.2 !important;
  }
  #farmer-benefits-{{ section.id }} .benefits-title {
    font-family: var(--title-font) !important;
    font-style: italic !important;
    font-weight: 500 !important;
    font-size: clamp(3.2rem, 3.6vw, 4.96rem) !important; /* Scaled clamp(2rem, 3.6vw, 3.1rem) */
    color: {{ section.settings.title_color }} !important;
    line-height: 1.05 !important;
    margin: 0 !important;
  }
  #farmer-benefits-{{ section.id }} .benefits-grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  #farmer-benefits-{{ section.id }} .benefit-item {
    background: {{ section.settings.card_bg }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 22px;
    padding: 26px;
    box-shadow: 0 10px 30px rgba(31, 61, 43, 0.03);
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  #farmer-benefits-{{ section.id }} .benefit-item.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }
  #farmer-benefits-{{ section.id }} .benefit-card-title {
    font-family: var(--font-family-1) !important;
    font-weight: 600 !important;
    font-size: 1.68rem !important; /* Scaled 1.05rem * 1.6 */
    color: {{ section.settings.title_color }} !important;
    margin: 0 0 8px 0 !important;
    line-height: 1.2 !important;
    letter-spacing:normal;
  }
  #farmer-benefits-{{ section.id }} .benefit-card-desc {
    font-family: var(--font-family-1) !important;
    font-size: 1.504rem !important; /* Scaled 0.94rem * 1.6 */
    color: {{ section.settings.desc_color }} !important;
    line-height: 1.55 !important;
    margin: 0 !important;
    letter-spacing: normal;
    letter-spacing:normal;
  }

  @media (max-width: 980px) {
    #farmer-benefits-{{ section.id }} .benefits-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
  @media (max-width: 620px) {
    #farmer-benefits-{{ section.id }} .benefits-grid {
      grid-template-columns: 1fr !important;
    }
  }
{%- endstyle -%}

<section id="farmer-benefits-{{ section.id }}" class="yild-farmer-benefits-section">
  <div class="benefits-header">
    {%- if section.settings.subtitle != blank -%}
      <span class="benefits-subtitle">{{ section.settings.subtitle }}</span>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="benefits-title">{{ section.settings.title }}</h2>
    {%- endif -%}
  </div>

  <div class="benefits-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'benefit_card' -%}
        <div class="benefit-item" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="benefit-card-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="benefit-card-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<script>
  (function() {
    let observer = null;
    function init() {
      const section = document.getElementById("farmer-benefits-{{ section.id }}");
      if (!section) return;

      const header = section.querySelector('.benefits-header');
      const items = section.querySelectorAll('.benefit-item');

      if (observer) observer.disconnect();
      observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      if (header) observer.observe(header);
      items.forEach(item => {
        observer.observe(item);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }

    document.addEventListener("shopify:section:load", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        init();
      }
    });

    document.addEventListener("shopify:section:unload", function(e) {
      if (e.detail.sectionId === "{{ section.id }}") {
        if (observer) observer.disconnect();
      }
    });
  })();
</script>

