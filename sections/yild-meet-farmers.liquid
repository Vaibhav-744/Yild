{{ 'component-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_image   = current_variant.image | default: product.featured_image
-%}

{%- style -%}
  /* ── Meet The Farmers – PDP ────────────────────────────────── */
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
  }

  #mtf-section-{{ section.id }}.productView {
    background: #f7f5ed;
    padding: clamp(36px, 5vw, 64px) clamp(20px, 4vw, 54px);
    display: block;
    max-width: unset;
    margin: 0;
    font-family: var(--body-font), 'Figtree', sans-serif;
  }

  #mtf-custom-cart-form-{{ section.id }} {
    margin: 0;
    padding: 0;
  }

  /* Grid wrapper */
  #mtf-grid-{{ section.id }} {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  /* ── Media col ────────────────────────────────────────────── */
  #mtf-section-{{ section.id }} #pdpMedia {
    position: sticky;
    top: 130px;
    width: 100%;
    display: block;
  }

  #mtf-section-{{ section.id }} .mtf-image-wrap {
    border-radius: 26px;
    overflow: hidden;
    background: #eaf0e9;
    aspect-ratio: 1;
    box-shadow: 0 20px 50px rgba(31,61,43,.12);
    display: flex;
    justify-content: center;
    align-items: center;
    border: none;
  }

  #mtf-section-{{ section.id }} .mtf-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #mtf-section-{{ section.id }} .placeholder-svg {
    width: 100%;
    height: 100%;
    fill: #7e9180;
    background-color: #eaf0e9;
    display: block;
  }

  /* ── Info col ─────────────────────────────────────────────── */


  /* Breadcrumb */
  #mtf-section-{{ section.id }} .mtf-breadcrumb {
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 13.1px;
    color: #5d6b60;
    margin-top: 0;
    margin-bottom: 16px;
    padding: 0;
  }
  #mtf-section-{{ section.id }} .mtf-breadcrumb a { color: #4e7355; }

  /* Event badge */
  #mtf-section-{{ section.id }} .mtf-badge {
    display: inline-block;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #4e7355;
    background: #eef3ec;
    padding: 5px 12px;
    border-radius: 100px;
    margin-top: 0;
    margin-bottom: 14px;
  }

  /* Title */
  #mtf-section-{{ section.id }} .mtf-title {
    font-family: var(--title-font), 'Newsreader', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(32px, 4vw, 49.6px);
    line-height: 1.06;
    color: #1f3d2b;
    margin-top: 0;
    margin-bottom: 14px;
    padding: 0;
  }

  /* Price row */
  #mtf-section-{{ section.id }} .mtf-price-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 0;
    margin-bottom: 16px;
    padding: 0;
  }
  #mtf-section-{{ section.id }} .mtf-price-row .price {
    font-family: var(--title-font), 'Newsreader', Georgia, serif;
    font-weight: 500;
    font-size: 32px;
    color: #1f3d2b;
    margin: 0;
  }
  #mtf-section-{{ section.id }} .mtf-price-row .price dl,
  #mtf-section-{{ section.id }} .mtf-price-row .price dd,
  #mtf-section-{{ section.id }} .mtf-price-row .price dt {
    margin: 0;
    padding: 0;
    display: inline-block;
  }
  #mtf-section-{{ section.id }} .mtf-price-row .price__last,
  #mtf-section-{{ section.id }} .mtf-price-row .price-item,
  #mtf-section-{{ section.id }} .mtf-price-row .price-item .money {
    font-family: var(--title-font), 'Newsreader', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    color: #1f3d2b;
    letter-spacing: normal;
    line-height: 1.06;
  }
  #mtf-section-{{ section.id }} .mtf-price-row .mtf-per {
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 14.4px;
    color: #5d6b60;
  }

  /* Short description */
  #mtf-section-{{ section.id }} .mtf-description {
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 16.8px;
    line-height: 1.65;
    color: #3a4a3d;
    margin-top: 0;
    margin-bottom: 22px;
    padding: 0;
    max-width: 52ch;
  }

  /* ── Variant picker override ──────────────────────────────── */
  #mtf-section-{{ section.id }} .productView-options {
    margin: 0 0 18px 0;
    padding: 0;
  }

  #mtf-section-{{ section.id }} .form__label {
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 13.6px;
    font-weight: 600;
    color: #3a4a3d;
    margin: 0 0 8px 0;
    padding: 0;
    display: block;
    border: none;
    float: none;
    width: auto;
    letter-spacing: normal;
    text-transform: none;
  }
  #mtf-section-{{ section.id }} [data-header-option] {
    font-weight: 400;
    color: #5d6b60;
    display: none;
  }

  /* Pill buttons */
  #mtf-section-{{ section.id }} .product-form__radio { display: none; }

  #mtf-section-{{ section.id }} .product-form__input {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    border: none;
    padding: 0;
    margin: 0 0 18px 0;
  }
  #mtf-section-{{ section.id }} .product-form__input:last-child {
    margin-bottom: 0;
  }

  /* Custom variant pill buttons */
  #mtf-section-{{ section.id }} .mtf-custom-variant-pill {
    padding: 11px 22px;
    border-radius: 100px;
    border: 1.5px solid #d6ddd2;
    background: #fff;
    color: #1f3d2b;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-weight: 600;
    font-size: 14.4px;
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: unset;
    height: unset;
    margin: 0;
    box-shadow: none;
    text-transform: none;
    letter-spacing: normal;
    outline: none;
  }
  #mtf-section-{{ section.id }} .mtf-custom-variant-pill:hover {
    background: #eef3ec;
    border-color: #4e7355;
    color: #1f3d2b;
  }
  #mtf-section-{{ section.id }} .mtf-custom-variant-pill[data-selected="true"] {
    background: #1f3d2b;
    color: #fff;
    border-color: #1f3d2b;
  }
  #mtf-section-{{ section.id }} .mtf-custom-variant-pill[data-selected="true"]:hover {
    background: #1f3d2b;
    color: #fff;
    border-color: #1f3d2b;
  }

  /* ── Quantity (theme quantity-input Web Component) ───────── */
  #mtf-section-{{ section.id }} .productView-quantity {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    justify-content: flex-start;
  }
  #mtf-section-{{ section.id }} .quantity__label {
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 13.6px;
    font-weight: 600;
    color: #3a4a3d;
    margin-bottom: 0;
    width: auto;
    min-width: unset;
    flex: unset;
  }
  #mtf-section-{{ section.id }} .quantity__container {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #d6ddd2;
    border-radius: 100px;
    overflow: hidden;
    background: #fff;
    margin: 0;
    width: auto;
  }
  #mtf-section-{{ section.id }} .btn-quantity,
  #mtf-section-{{ section.id }} .quantity__container button,
  #mtf-section-{{ section.id }} .quantity__container .minus,
  #mtf-section-{{ section.id }} .quantity__container .plus {
    width: 42px;
    height: 42px;
    border: none;
    background: none;
    font-size: 19.2px;
    cursor: pointer;
    color: #1f3d2b;
    padding: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    transition: background .2s;
  }
  #mtf-section-{{ section.id }} .quantity__container button svg,
  #mtf-section-{{ section.id }} .quantity__container button span::before,
  #mtf-section-{{ section.id }} .quantity__container button span::after {
    display: none;
  }
  #mtf-section-{{ section.id }} .btn-quantity:hover,
  #mtf-section-{{ section.id }} .quantity__container button:hover { background: #f0f5f0; }
  #mtf-section-{{ section.id }} .quantity__input {
    width: 40px;
    padding: 0;
    text-align: center;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-weight: 600;
    font-size: 16.8px;
    border: none;
    outline: none;
    background: transparent;
    color: #1f3d2b;
    -moz-appearance: textfield;
    height: 42px;
    line-height: 42px;
    margin: 0;
    min-width: unset;
    max-width: unset;
  }
  #mtf-section-{{ section.id }} .quantity__input::-webkit-inner-spin-button,
  #mtf-section-{{ section.id }} .quantity__input::-webkit-outer-spin-button { -webkit-appearance: none; }

  /* ── ATC button ──────────────────────────────────────────── */
  #mtf-section-{{ section.id }} .productView-buttons { margin-bottom: 0; }

  #mtf-section-{{ section.id }} .product-form__submit,
  #mtf-section-{{ section.id }} .button--primary {
    width: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-weight: 600;
    font-size: 16.3px;
    padding: 16px;
    border-radius: 100px;
    background: #1f3d2b;
    color: #fff;
    border: none;
    cursor: pointer;
    transition: background .25s, color .25s;
    margin-bottom: 12px;
    text-transform: none;
    box-shadow: none;
  }
  #mtf-section-{{ section.id }} .product-form__submit svg,
  #mtf-section-{{ section.id }} .button--primary svg {
    flex: 0 0 auto;
    margin: 0;
    display: block;
    height:20px;
    width:15px;
    fill:none;
  }
  #mtf-section-{{ section.id }} .product-form__submit:hover,
  #mtf-section-{{ section.id }} .button--primary:hover {
    background: #16301f;
  }
  #mtf-section-{{ section.id }} .product-form__submit[disabled] {
    opacity: .5;
    cursor: not-allowed;
  }

  /* ── Availability pill ───────────────────────────────────── */
  #mtf-section-{{ section.id }} .mtf-availability {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 14.4px;
    font-weight: 600;
    color: #2f7d4f;
    margin-bottom: 22px;
  }
  #mtf-section-{{ section.id }} .mtf-availability-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2f7d4f;
    flex: 0 0 auto;
  }
  #mtf-section-{{ section.id }} .mtf-availability.unavailable { color: #b04040; }
  #mtf-section-{{ section.id }} .mtf-availability.unavailable .mtf-availability-dot { background: #b04040; }

  /* ── Benefits list ───────────────────────────────────────── */
  #mtf-section-{{ section.id }} .mtf-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 15.4px;
    color: #3a4a3d;
    margin: 0 0 26px 0;
    padding: 0;
  }
  #mtf-section-{{ section.id }} .mtf-benefits li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #mtf-section-{{ section.id }} .mtf-benefits li .mtf-check { color: #4e7355; font-weight: 700; flex: 0 0 auto; }

  /* ── FAQ accordion ───────────────────────────────────────── */
  #mtf-section-{{ section.id }} .mtf-faqs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  #mtf-section-{{ section.id }} .mtf-faq {
    background: #fff;
    border: 1px solid #e6ebe2;
    border-radius: 16px;
    overflow: hidden;
    margin: 0;
    padding: 0;
    box-shadow: none;
  }
  #mtf-section-{{ section.id }} .mtf-faq summary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 16px 18px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-weight: 600;
    font-size: 15.7px;
    color: #1f3d2b;
    list-style: none;
    user-select: none;
    outline: none;
    box-shadow: none;
  }
  #mtf-section-{{ section.id }} .mtf-faq summary::-webkit-details-marker { display: none; }
  #mtf-section-{{ section.id }} .mtf-faq summary::marker { display: none; content: ""; }
  #mtf-section-{{ section.id }} .mtf-faq-icon {
    flex: 0 0 auto;
    font-size: 19.2px;
    font-weight: 400;
    color: #4e7355;
    transition: transform .3s ease;
  }
  #mtf-section-{{ section.id }} .mtf-faq[open] .mtf-faq-icon { transform: rotate(45deg); }
  #mtf-section-{{ section.id }} .mtf-faq-answer {
    padding: 0 18px 16px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #5d6b60;
    border: none;
  }
  #mtf-section-{{ section.id }} .mtf-faq-answer p {
    margin: 0;
    padding: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-family: inherit;
  }

  #mtf-section-{{ section.id }} .mtf-custom-price {
    font-family: var(--title-font), 'Newsreader', Georgia, serif;
    font-weight: 500;
    font-size: 32px;
    color: #1f3d2b;
  }
  #mtf-section-{{ section.id }} .mtf-custom-variants-wrapper {
    margin-bottom: 18px;
  }
  #mtf-section-{{ section.id }} .mtf-option-label {
    font-size: 13.6px;
    font-weight: 600;
    color: #3a4a3d;
    margin-bottom: 8px;
    font-family: var(--body-font), 'Figtree', sans-serif;
    letter-spacing: normal;
    text-transform: none;
  }
  #mtf-section-{{ section.id }} .mtf-custom-variants-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  #mtf-section-{{ section.id }} .mtf-qty-display {
    min-width: 34px;
    text-align: center;
    font-weight: 600;
    color: #1f3d2b;
    font-family: var(--body-font), 'Figtree', sans-serif;
    user-select: none;
    font-size:16px;
  }
  #mtf-section-{{ section.id }} .product-form__submit.success,
  #mtf-section-{{ section.id }} .button--primary.success {
    background: #2f7d4f;
  }
  #mtf-section-{{ section.id }} .mtf-image-wrap image-slot {
    width: 100%;
    height: 100%;
  }

  /* ── Scroll reveal ───────────────────────────────────────── */
  #mtf-section-{{ section.id }} [data-mtf-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 980px) {
    #mtf-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }
    #mtf-section-{{ section.id }} #pdpMedia {
      position: static;
      max-width: 520px;
      margin: 0 auto;
    }
    #mtf-section-{{ section.id }} .product-form__submit,
    #mtf-section-{{ section.id }} .button--primary { max-width: 100%; }
  }
{%- endstyle -%}

<section id="mtf-section-{{ section.id }}" class="productView">
  <div id="mtf-grid-{{ section.id }}">

    {%- comment -%}── LEFT: sticky image ──{%- endcomment -%}
    <div id="pdpMedia" data-mtf-reveal>
      <div class="mtf-image-wrap">
        {%- if product_image -%}
          <img
            id="meet-farmers-poster"
            src="{{ product_image | image_url: width: 900 }}"
            srcset="{{ product_image | image_url: width: 600 }} 600w,
                    {{ product_image | image_url: width: 900 }} 900w,
                    {{ product_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width:900px) 90vw, 50vw"
            alt="{{ product_image.alt | escape | default: product.title | escape }}"
            width="900"
            height="900"
            loading="eager"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}── RIGHT: product info ──{%- endcomment -%}
    <div id="mtf-info-{{ section.id }}" data-mtf-reveal data-delay="90">

      {%- comment -%}Breadcrumb{%- endcomment -%}
      <nav class="mtf-breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        {%- if collection -%}
          · <a href="{{ collection.url }}">{{ collection.title }}</a>
        {%- endif -%}
        · <span>{{ product.title }}</span>
      </nav>

      {%- comment -%}Badge{%- endcomment -%}
      {%- if section.settings.event_badge != blank -%}
        <span class="mtf-badge">{{ section.settings.event_badge }}</span>
      {%- endif -%}

      {%- comment -%}Title{%- endcomment -%}
      <h1 class="mtf-title">{{ product.title }}</h1>

      {%- comment -%}Price{%- endcomment -%}
      <div class="mtf-price-row">
        <span id="mtf-custom-price" class="mtf-custom-price">
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {%- if section.settings.price_label != blank -%}
          <span class="mtf-per">{{ section.settings.price_label }}</span>
        {%- endif -%}
      </div>

      {%- comment -%}Description / excerpt{%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="mtf-description">
          {{ product.description | strip_html | truncate: 320 }}
        </div>
      {%- endif -%}

      {%- comment -%}
        ── CUSTOM PRODUCT FORM ──
        Completely custom layout that mirrors meet-the-farmers.html exactly.
      {%- endcomment -%}
      <form method="post" action="/cart/add" id="mtf-custom-cart-form-{{ section.id }}" accept-charset="UTF-8" class="form" enctype="multipart/form-data">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        
        {%- comment -%}── Hidden variant id input (updated dynamically by custom JS) ──{%- endcomment -%}
        <input type="hidden" name="id" id="mtf-custom-variant-id-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">
        
        {%- comment -%}── Custom Variant Picker (Pills) ──{%- endcomment -%}
        {%- unless product.has_only_default_variant -%}
          <div class="mtf-custom-variants-wrapper">
            {%- for option in product.options_with_values -%}
              <div class="mtf-custom-variants-wrapper">
                <div class="mtf-option-label">{{ option.name }}</div>
                <div class="mtf-custom-variants-pills" data-option-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    {%- liquid
                      assign is_selected = false
                      if option.selected_value == value
                        assign is_selected = true
                      endif
                    -%}
                    <button type="button"
                      class="mtf-custom-variant-pill"
                      data-option-value="{{ value | escape }}"
                      {% if is_selected %}data-selected="true"{% endif %}
                    >
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- comment -%}── Custom Quantity Selector ──{%- endcomment -%}
        <div class="productView-quantity">
          <span class="quantity__label">Quantity</span>
          <div class="quantity__container">
            <button type="button" id="qtyMinus-{{ section.id }}" aria-label="Decrease quantity">−</button>
            <span id="qtyVal-{{ section.id }}" class="mtf-qty-display">1</span>
            <button type="button" id="qtyPlus-{{ section.id }}" aria-label="Increase quantity">+</button>
          </div>
          <input type="hidden" name="quantity" id="mtf-custom-qty-input-{{ section.id }}" value="1">
        </div>

        {%- comment -%}── Custom Add To Basket Button ──{%- endcomment -%}
        <div class="productView-buttons">
          {%- if product.selected_or_first_available_variant.available -%}
            <button
              type="button"
              id="addBtn-{{ section.id }}"
              class="product-form__submit"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 7h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 7Z"/>
                <path d="M9 7V5.5a3 3 0 0 1 6 0V7"/>
              </svg>
              Add To Basket
            </button>
          {%- else -%}
            <button
              type="button"
              id="addBtn-{{ section.id }}"
              class="product-form__submit"
              disabled
            >
              Sold Out
            </button>
          {%- endif -%}
        </div>
      </form>

      {%- comment -%}── Availability indicator ──{%- endcomment -%}
      <p id="mtf-custom-availability" class="mtf-availability {% unless product.selected_or_first_available_variant.available %}unavailable{% endunless %}">
        <span id="mtf-custom-availability-dot" class="mtf-availability-dot"></span>
        <span id="mtf-custom-availability-text">
          {%- if product.selected_or_first_available_variant.available -%}
            In Stock
            {%- if product.selected_or_first_available_variant.inventory_management != blank and product.selected_or_first_available_variant.inventory_quantity > 0 -%}
              · {{ product.selected_or_first_available_variant.inventory_quantity }} left in stock
            {%- endif -%}
          {%- else -%}
            Out of Stock
          {%- endif -%}
        </span>
      </p>

      {%- comment -%}── Benefits list from section settings ──{%- endcomment -%}
      {%- if section.settings.benefit_1 != blank or section.settings.benefit_2 != blank or section.settings.benefit_3 != blank -%}
        <ul class="mtf-benefits">
          {%- for i in (1..5) -%}
            {%- assign benefit_key = 'benefit_' | append: i -%}
            {%- assign benefit_val = section.settings[benefit_key] -%}
            {%- if benefit_val != blank -%}
              <li><span class="mtf-check">✓</span>{{ benefit_val }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%}── FAQ accordion (native <details>) ──{%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="mtf-faqs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details class="mtf-faq" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  {{ block.settings.question }}
                  <span class="mtf-faq-icon" aria-hidden="true">+</span>
                </summary>
                <div class="mtf-faq-answer">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div><!-- /mtf-info -->
  </div><!-- /mtf-grid -->
</section>

<script id="mtf-variants-json-{{ section.id }}" type="application/json">
  {{ product.variants | json }}
</script>

<script>
(function() {
  var sectionId = '{{ section.id }}';

  // Parse custom variants JSON array
  var variantsData = [];
  try {
    var jsonEl = document.getElementById('mtf-variants-json-' + sectionId);
    if (jsonEl) {
      variantsData = JSON.parse(jsonEl.textContent);
    }
  } catch (e) {
    console.error('Failed to parse variant JSON data', e);
  }

  // Active custom variant options cache
  var selectedOptions = [];
  {%- for option in product.options_with_values -%}
    selectedOptions.push({
      name: {{ option.name | json }},
      value: {{ option.selected_value | json }}
    });
  {%- endfor -%}

  // Helper format money custom action matching Shopify's formats
  var formatPrice = function(cents) {
    if (window.Shopify && window.Shopify.formatMoney) {
      return window.Shopify.formatMoney(cents, "{{ shop.money_format }}");
    }
    var num = (cents / 100).toFixed(2);
    var format = "{{ shop.money_format | strip_html }}";
    if (format.indexOf('amount') !== -1) {
      return format.replace(/\{\{\s*amount\s*\}\}/g, num)
                   .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.round(cents/100).toString())
                   .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, num.replace('.', ','));
    }
    return '£' + num;
  };

  // Function to execute dynamic content switching
  var updateVariantSelection = function() {
    var matchedVariant = variantsData.find(function(v) {
      return selectedOptions.every(function(opt, idx) {
        var optProp = 'option' + (idx + 1);
        return v[optProp] === opt.value;
      });
    });

    var varInput = document.getElementById('mtf-custom-variant-id-' + sectionId);
    var addBtn = document.getElementById('addBtn-' + sectionId);
    var priceEl = document.getElementById('mtf-custom-price');
    var availTextEl = document.getElementById('mtf-custom-availability-text');
    var availDotEl = document.getElementById('mtf-custom-availability-dot');
    var availContainer = document.getElementById('mtf-custom-availability');

    if (matchedVariant) {
      if (varInput) varInput.value = matchedVariant.id;
      if (priceEl) priceEl.textContent = formatPrice(matchedVariant.price);

      // Update availability states
      if (matchedVariant.available) {
        if (addBtn) {
          addBtn.removeAttribute('disabled');
          addBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 auto;margin:0;display:block;"><path d="M5 7h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 7Z"/><path d="M9 7V5.5a3 3 0 0 1 6 0V7"/></svg> Add To Basket';
        }
        if (availContainer) {
          availContainer.classList.remove('unavailable');
        }
        if (availTextEl) {
          var leftText = '';
          if (matchedVariant.inventory_management && matchedVariant.inventory_quantity > 0) {
            leftText = ' · ' + matchedVariant.inventory_quantity + ' left in stock';
          }
          availTextEl.textContent = 'In Stock' + leftText;
        }
      } else {
        if (addBtn) {
          addBtn.setAttribute('disabled', 'disabled');
          addBtn.innerHTML = 'Sold Out';
        }
        if (availContainer) {
          availContainer.classList.add('unavailable');
        }
        if (availTextEl) {
          availTextEl.textContent = 'Out of Stock';
        }
      }
    }
  };

  // Wire custom variant pill click behavior
  var pillContainers = document.querySelectorAll('.mtf-custom-variants-pills');
  pillContainers.forEach(function(container) {
    var optIdx = parseInt(container.getAttribute('data-option-index'));
    var pills = container.querySelectorAll('.mtf-custom-variant-pill');
    pills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        pills.forEach(function(p) {
          p.removeAttribute('data-selected');
        });
        pill.setAttribute('data-selected', 'true');

        selectedOptions[optIdx].value = pill.getAttribute('data-option-value');
        updateVariantSelection();
      });
    });
  });

  // Quantity Stepper controls
  var qty = 1;
  var qEl = document.getElementById('qtyVal-' + sectionId);
  var qInput = document.getElementById('mtf-custom-qty-input-' + sectionId);
  var btnMinus = document.getElementById('qtyMinus-' + sectionId);
  var btnPlus = document.getElementById('qtyPlus-' + sectionId);

  var setQty = function(n) {
    qty = Math.max(1, Math.min(99, n));
    if (qEl) qEl.textContent = String(qty);
    if (qInput) qInput.value = String(qty);
  };

  if (btnMinus) {
    btnMinus.addEventListener('click', function() { setQty(qty - 1); });
  }
  if (btnPlus) {
    btnPlus.addEventListener('click', function() { setQty(qty + 1); });
  }

  // Custom AJAX Form submission with drawer opening fallback
  var addBtn = document.getElementById('addBtn-' + sectionId);
  var form = document.getElementById('mtf-custom-cart-form-' + sectionId);

  if (addBtn && form) {
    addBtn.addEventListener('click', function() {
      if (addBtn.hasAttribute('disabled')) return;

      var origText = addBtn.innerHTML;
      addBtn.innerHTML = '✓ Added to basket';
      addBtn.classList.add('success');

      var formData = new FormData(form);
      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(function(res) {
        return res.json();
      })
      .then(function(item) {
        // Increment quantity in header count
        var cartCountEl = document.querySelectorAll('[data-cart-count]');
        cartCountEl.forEach(function(el) {
          var count = parseInt(el.textContent) || 0;
          el.textContent = String(count + qty);
        });

        // Trigger cart drawers
        if (window.quick_cart && window.quick_cart.show) {
          if (window.Shopify && window.Shopify.getCart) {
            window.Shopify.getCart(function(cart) {
              var body = document.querySelector('body');
              if (body) {
                body.classList.add('cart-sidebar-show');
                if (window.halo && window.halo.updateSidebarCart) {
                  window.halo.updateSidebarCart(cart);
                }
              }
            });
          }
        }

        setTimeout(function() {
          addBtn.innerHTML = origText;
          addBtn.classList.remove('success');
        }, 1300);
      })
      .catch(function(err) {
        console.error('AJAX add to cart failed, falling back to standard redirect', err);
        form.submit();
      });
    });
  }
})();
</script>

