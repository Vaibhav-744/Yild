{%- liquid
    assign section_bg = section.settings.bg_color
    assign collection_ref = collections[section.settings.collection]
    assign limit = section.settings.limit | default: 8
-%}

<style>
  .yild-shop-picks-section {
    padding: clamp(58px, 7vw, 108px) 0;
    background-color: {{ section_bg }};
  }
  .yild-shop-picks-section .container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 54px);
  }
  
  /* Shop Header Styles */
  .yild-shop-picks-section .shop-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(30px, 4vw, 50px);
  }
  .yild-shop-picks-section .shop-head-subtitle {
    display: inline-block;
    font-size: 1.216rem !important;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--yild-green-muted);
    margin-bottom: 12px;
    font-family: var(--font-family-1);
  }
  .yild-shop-picks-section .shop-head-title {
    font-family: var(--font-family-2);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(3.2rem, 5.76vw, 4.96rem);
    letter-spacing: -.01em;
    color: var(--yild-green-dark);
    line-height: 1.05;
    margin: 0;
    text-transform: none;
  }
  .yild-shop-picks-section .shop-head-cta {
    font-family: var(--font-family-1);
    font-weight: 600;
    font-size: 1.408rem !important;
    padding: 12px 24px;
    border-radius: 100px;
    border: 1.5px solid var(--yild-border-muted);
    color: var(--yild-green-dark);
    text-decoration: none;
    transition: all 0.2s;
  }
  .yild-shop-picks-section .shop-head-cta:hover {
    background: rgba(31, 61, 43, 0.05);
  }

  /* Scroller & Grid Styles */
  .yild-shop-picks-section .yild-scroller {
    scrollbar-width: none;
    -ms-overflow-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    margin: 0 -4px;
    padding: 4px;
  }
  .yild-shop-picks-section .yild-scroller::-webkit-scrollbar {
    display: none;
  }
  .yild-shop-picks-section .shop-grid {
    display: flex;
    gap: 22px;
  }
  .yild-shop-picks-section .prodCard {
    flex: 0 0 calc(25% - 16.5px);
    width: calc(25% - 16.5px);
    background: #ffffff;
    border: 1px solid var(--yild-border-color);
    border-radius: 22px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(31, 61, 43, 0.05);
    transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s;
    scroll-snap-align: start;
  }
  .yild-shop-picks-section .prodCard:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 44px rgba(31, 61, 43, 0.12);
  }
  .yild-shop-picks-section .card-img-wrapper {
    position: relative;
    aspect-ratio: 1.08;
    background: var(--yild-green-light);
    overflow: hidden;
    border-radius: 18px 18px 0 0;
  }
  .yild-shop-picks-section .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .yild-shop-picks-section .prodCard:hover .card-img {
    transform: scale(1.05);
  }
  .yild-shop-picks-section .card-top-tag {
    position: absolute;
    top: 11px;
    left: 11px;
    z-index: 2;
    font-size: 1.088rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--yild-green-dark);
    background: rgba(247, 245, 237, .92);
    padding: 5px 10px;
    border-radius: 100px;
    font-family: var(--font-family-1);
  }
  .yild-shop-picks-section .card-details {
    padding: 16px 17px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .yild-shop-picks-section .card-vendor {
    font-size: 1.136rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--yild-green-muted);
    font-weight: 600;
    font-family: var(--font-family-1);
  }
  .yild-shop-picks-section .card-title-link {
    text-decoration: none;
    color: inherit;
  }
  .yild-shop-picks-section .card-title {
    font-family: var(--font-family-1);
    font-size: 1.68rem;
    line-height: 1.2;
    color: var(--yild-green-dark);
    margin: 0;
    text-transform: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  /* Card row details */
  .yild-shop-picks-section .card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
  }
  .yild-shop-picks-section .card-price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .yild-shop-picks-section .card-price {
    font-family: var(--font-family-1);
    font-weight: 700;
    font-size: 1.792rem;
    color: var(--yild-green-dark);
  }
  .yild-shop-picks-section .card-compare-price {
    color: var(--yild-text-muted-2);
    text-decoration: line-through;
    font-size: 1.312rem;
    font-family: var(--font-family-1);
  }

  /* Inventory Pills */
  .yild-shop-picks-section .inventory-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 100px;
    font-weight: 600;
    font-size: 1.312rem;
    font-family: var(--font-family-1);
  }
  .yild-shop-picks-section .inventory-pill.in-stock {
    background: var(--yild-bg-success);
    border: 1px solid var(--yild-border-success);
    color: var(--yild-green-success);
  }
  .yild-shop-picks-section .inventory-pill.in-stock .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yild-green-success);
  }
  .yild-shop-picks-section .inventory-pill.out-of-stock {
    background: var(--yild-bg-error);
    border: 1px solid var(--yild-border-error);
    color: var(--yild-red-error);
  }
  .yild-shop-picks-section .inventory-pill.out-of-stock .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yild-red-error);
  }

  /* Add to basket button */
  .yild-shop-picks-section .atc-btn {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-family-1);
    font-weight: 600;
    font-size: 1.44rem;
    padding: 11px;
    border-radius: 100px;
    background: var(--yild-green-dark);
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition: background 0.25s, transform 0.15s;
    width: 100%;
  }
  .yild-shop-picks-section .atc-btn svg {
    width: 16px !important;
    height: 16px !important;
    fill: currentColor !important;
    stroke: none !important;
    display: inline-block !important;
    vertical-align: middle !important;
  }
  .yild-shop-picks-section .atc-btn:hover {
    background: var(--yild-green-hover);
  }
  .yild-shop-picks-section .atc-btn:active {
    transform: scale(0.97);
  }
  .yild-shop-picks-section .atc-btn.sold-out {
    background: #a9b5ab !important;
    color: #ffffff !important;
    cursor: not-allowed;
  }

  /* Slider Dots Pagination styling */
  .yild-shop-picks-section .yild-slider-dots {
    display: flex;
    justify-content: center;
    margin-top: clamp(22px, 3vw, 32px);
  }
  .yild-shop-picks-section .yild-slider-dots button {
    height: 9px;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 100px;
    background: var(--yild-dots-inactive);
    margin: 0 4px;
    width: 9px;
    transition: width .3s cubic-bezier(.16,1,.3,1), background .3s;
  }
  .yild-shop-picks-section .yild-slider-dots button.active {
    width: 26px;
    background: var(--yild-green-dark);
  }

  @media (max-width: 1024px) {
    .yild-shop-picks-section .prodCard {
      flex: 0 0 calc(33.33% - 14.67px);
      width: calc(33.33% - 14.67px);
    }
  }
  @media (max-width: 768px) {
    .yild-shop-picks-section .prodCard {
      flex: 0 0 calc(50% - 11px);
      width: calc(50% - 11px);
    }
  }
  @media (max-width: 480px) {
    .yild-shop-picks-section .prodCard {
      flex: 0 0 85%;
      width: 85%;
    }
  }
</style>

<section id="shop-picks-{{ section.id }}" class="yild-shop-picks-section" data-section-id="{{ section.id }}" data-section-type="yild-shop-picks">
  <div class="container">
    
    <div class="shop-head">
      <div>
        <span class="shop-head-subtitle">{{ section.settings.eyebrow }}</span>
        <h2 class="shop-head-title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}
        <a href="{{ collection_ref.url }}" class="shop-head-cta">{{ section.settings.cta_text }}</a>
      {%- endif -%}
    </div>

    <div id="shopViewport-{{ section.id }}" class="yild-scroller">
      <div class="shop-grid">
        {%- if section.settings.collection != blank and collection_ref.products.size > 0 -%}
          {%- for product in collection_ref.products limit: limit -%}
            {%- liquid
              assign available_qty = product.variants.first.inventory_quantity
              assign tracked = product.variants.first.inventory_management
            -%}
            <article class="prodCard product-item" data-product-id="{{ product.id }}" data-json-product='{"id": {{product.id}},"handle": "{{product.handle}}","media": {{product.media | json | escape}},"variants": {{ product.variants | json | escape}}}'>
              
              <div class="card-img-wrapper">
                {%- if section.settings.enable_top_tag -%}
                  {%- assign top_tag = product.metafields.custom.product_card_top_tag -%}
                  {%- if top_tag != blank -%}
                    <span class="card-top-tag">{{ top_tag }}</span>
                  {%- endif -%}
                {%- endif -%}
                <a href="{{ product.url | within: collection_ref }}" class="d-block h-100 w-100" aria-label="{{ product.title }}">
                  {%- if product.featured_media -%}
                    <img src="{{ product.featured_media | img_url: '450x450', crop: 'center' }}" alt="{{ product.title | escape }}" loading="lazy" class="card-img" />
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
              </div>

              <div class="card-details">
                {%- assign card_vendor = product.metafields.custom.product_card_vendor | default: product.vendor -%}
                <span class="card-vendor">{{ card_vendor }}</span>
                <a class="card-title-link" href="{{ product.url | within: collection_ref }}">
                  <h3 class="card-title">{{ product.title }}</h3>
                </a>
                
                <div class="card-row">
                  {%- if product.available == false -%}
                    <span class="inventory-pill out-of-stock">
                      <span class="dot"></span>
                      Sold out
                    </span>
                  {%- elsif tracked -%}
                    <span class="inventory-pill in-stock">
                      <span class="dot"></span>
                      {{ available_qty }}
                    </span>
                  {%- else -%}
                    <span class="inventory-pill in-stock">
                      <span class="dot"></span>
                      Available
                    </span>
                  {%- endif -%}

                  <div class="card-price-wrapper">
                    <span class="card-price">
                      {{ product.price | money }}
                    </span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="card-compare-price">
                        {{ product.compare_at_price | money }}
                      </span>
                    {%- endif -%}
                  </div>
                </div>

                {%- if product.available == false -%}
                  <button type="button" disabled="disabled" class="atc-btn sold-out">
                    Sold out
                  </button>
                {%- else -%}
                  {%- if product.variants.size > 1 and settings.show_quick_shop -%}
                    <button type="button" data-quickshop-popup data-product-handle="{{ product.handle }}" class="atc-btn">
                      {%- render 'icon-cart', class: 'w-h-16' -%}
                      Add to basket
                    </button>
                  {%- else -%}
                    <form action="{{ routes.cart_url }}/add" method="post" class="variants">
                      <input type="hidden" name="id" value="{{ product.variants[0].id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" data-btn-addToCart class="atc-btn">
                        {%- render 'icon-cart', class: 'w-h-16' -%}
                        Add to basket
                      </button>
                    </form>
                  {%- endif -%}
                {%- endif -%}

              </div>

            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <article class="prodCard">
              <div class="card-img-wrapper">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="card-details">
                <span class="card-vendor">Local Farm</span>
                <h3 class="card-title">Example Product Name {{ i }}</h3>
                <div class="card-row">
                  <span class="inventory-pill in-stock"><span class="dot"></span>10</span>
                  <span class="card-price">£2.50</span>
                </div>
                <button type="button" class="atc-btn">
                  {%- render 'icon-cart', class: 'w-h-16' -%}
                  Add to basket
                </button>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    
    <div id="shopDots-{{ section.id }}" class="yild-slider-dots"></div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initSlider = () => {
      const viewport = document.getElementById('shopViewport-{{ section.id }}');
      const grid = viewport ? viewport.querySelector('.shop-grid') : null;
      const dots = document.getElementById('shopDots-{{ section.id }}');
      if (!viewport || !grid || !dots) return;

      const cards = () => [...grid.children];
      const state = { page: 0, pages: 1 };

      const getPerView = () => {
        const firstCard = cards()[0];
        if (!firstCard) return 1;
        const cardWidth = firstCard.getBoundingClientRect().width;
        const viewportWidth = viewport.getBoundingClientRect().width;
        return Math.max(1, Math.round(viewportWidth / cardWidth));
      };

      const renderDots = () => {
        dots.innerHTML = '';
        for (let i = 0; i < state.pages; i++) {
          const d = document.createElement('button');
          d.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === state.page) d.classList.add('active');
          d.addEventListener('click', () => {
            state.page = i;
            const pv = getPerView();
            const targetCard = cards()[Math.min(i * pv, cards().length - 1)];
            if (targetCard) {
              viewport.scrollTo({
                left: targetCard.offsetLeft - grid.offsetLeft,
                behavior: 'smooth'
              });
            }
            updateDots();
          });
          dots.appendChild(d);
        }
      };

      const updateDots = () => {
        const children = [...dots.children];
        if (children.length !== state.pages) {
          renderDots();
          return;
        }
        children.forEach((d, i) => {
          if (i === state.page) {
            d.classList.add('active');
          } else {
            d.classList.remove('active');
          }
        });
      };

      const layout = () => {
        const pv = getPerView();
        state.pages = Math.ceil(cards().length / pv);
        state.page = Math.min(state.page, state.pages - 1);
        updateDots();
        dots.style.display = state.pages > 1 ? 'flex' : 'none';
      };

      let scrollTimeout;
      viewport.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = viewport.scrollLeft;
          const maxScroll = viewport.scrollWidth - viewport.clientWidth;
          if (maxScroll <= 0) return;
          
          let page;
          if (scrollLeft >= maxScroll - 15) {
            page = state.pages - 1;
          } else {
            page = Math.round(scrollLeft / viewport.clientWidth);
          }
          
          if (page !== state.page && page >= 0 && page < state.pages) {
            state.page = page;
            updateDots();
          }
        }, 90);
      }, { passive: true });

      window.addEventListener('resize', layout);
      layout();
    };

    initSlider();
    document.addEventListener('shopify:section:load', (e) => {
      if (e.detail.sectionId === '{{ section.id }}') {
        initSlider();
      }
    });
  });
</script>

{% schema %}
{
  "name": "Yild Shop Picks",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Explore our store · fresh this week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real food from real farms, this week"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Start shopping"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product Limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_top_tag",
      "label": "Enable Metafield Top Tag",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f5ed"
    }
  ],
  "presets": [
    {
      "name": "Yild Shop Picks",
      "category": "Collection"
    }
  ]
}
{% endschema %}
